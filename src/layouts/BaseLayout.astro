---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** ISO date used to sort search results (newest first). Dated content
   *  (articles, events, updates) passes its real date; static pages keep
   *  the far-future default so they surface above the article archive. */
  sortDate?: string;
  /** Set false on aggregator/listing pages (article index, archives) so
   *  search returns the underlying content, not the lists that repeat it. */
  searchable?: boolean;
}

const { title, description = "Beaumont-Wilshire Neighborhood Association - A vibrant community in Northeast Portland", noindex = false, sortDate = '9999-12-31', searchable = true } = Astro.props;
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <title>{title} | BWNA</title>
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`}>
</head>
<body>
  <header class="site-header">
    <div class="container header-content">
      <a href={base} class="site-logo">
        <img src={`${base}images/bwna-logo-menu.png`} alt="BWNA" width="1000" height="236">
      </a>

      <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Toggle navigation">
      <label for="nav-toggle" class="hamburger" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </label>

      <nav class="main-nav">
        <ul>
          <li><a href={base} class={currentPath === base || currentPath === base.replace(/\/$/, '') ? 'active' : ''}>Home</a></li>
          <li class="has-dropdown">
            <a href={`${base}about`} class={currentPath.includes('/about') || currentPath.includes('/board') || currentPath.includes('/committees') || currentPath.includes('/bylaws') || currentPath.includes('/policies') || currentPath.includes('/contact') ? 'active' : ''}>About Us</a>
            <ul class="dropdown">
              <li><a href={`${base}about`}>Who We Are</a></li>
              <li><a href={`${base}board`}>Our Board</a></li>
              <li><a href={`${base}committees`}>Committees</a></li>
              <li><a href={`${base}bylaws`}>Bylaws</a></li>
              <li><a href={`${base}policies`}>Policies</a></li>
              <li><a href={`${base}contact`}>Contact Us</a></li>
            </ul>
          </li>
          <li class="has-dropdown">
            <a href={`${base}events`} class={currentPath.includes('/events') || currentPath.includes('/community-updates') || currentPath.includes('/meeting-minutes') || currentPath.includes('/get-involved') || currentPath.includes('/subscribe') ? 'active' : ''}>What's Happening?</a>
            <ul class="dropdown">
              <li><a href={`${base}events`}>Upcoming Events</a></li>
              <li><a href={`${base}community-updates`}>Community Updates</a></li>
              <li><a href={`${base}meeting-minutes`}>Meeting Minutes</a></li>
              <li><a href={`${base}get-involved`}>Get Involved</a></li>
              <li><a href={`${base}subscribe`}>Subscribe</a></li>
            </ul>
          </li>
          <li><a href={`${base}public-plaza`} class={currentPath.includes('/public-plaza') ? 'active' : ''}>Public Plaza</a></li>
          <li class="has-dropdown">
            <a href={`${base}newsletters`} class={currentPath.includes('/newsletters') || currentPath.includes('/newsletter') || currentPath.includes('/ad-rates') || currentPath.includes('/articles') ? 'active' : ''}>Newsletter</a>
            <ul class="dropdown">
              <li><a href={`${base}newsletters`}>Current Issue</a></li>
              <li><a href={`${base}articles`}>All Articles</a></li>
              <li><a href={`${base}newsletter-submissions`}>Newsletter Submissions</a></li>
              <li><a href={`${base}ad-rates`}>Ad Rates</a></li>
            </ul>
          </li>
          <li><a href={`${base}resources`} class={currentPath.includes('/resources') ? 'active' : ''}>Community Resources</a></li>
          <li><a href={`${base}search`} class={`nav-search ${currentPath.includes('/search') ? 'active' : ''}`}>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            Search
          </a></li>
        </ul>
      </nav>

      <a href={`${base}subscribe`} class="btn-subscribe">Subscribe</a>
    </div>
  </header>

  <main {...!noindex && searchable && { 'data-pagefind-body': '', 'data-pagefind-sort': 'date[data-date]', 'data-pagefind-meta': 'date[data-date]', 'data-date': sortDate }}>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-content">
        <div class="footer-section">
          <h4>BWNA</h4>
          <p>Working to enhance livability in our neighborhood.</p>
        </div>

        <div class="footer-section">
          <h4>Quick Links</h4>
          <ul>
            <li><a href={`${base}about`}>About Us</a></li>
            <li><a href={`${base}events`}>Upcoming Events</a></li>
            <li><a href={`${base}public-plaza`}>Public Plaza</a></li>
            <li><a href={`${base}newsletters`}>Newsletter</a></li>
            <li><a href={`${base}get-involved`}>Get Involved</a></li>
          </ul>
        </div>

        <div class="footer-section">
          <h4>Contact</h4>
          <ul>
            <li><a href={`${base}contact`}>Contact Us</a></li>
          </ul>
        </div>

        <div class="footer-section">
          <h4>Stay Connected</h4>
          <p>Sign up to receive our monthly Community Updates for information about BWNA meetings, events, neighborhood news, and volunteer opportunities.</p>
          <a href={`${base}subscribe`} class="btn btn-secondary">Subscribe</a>
        </div>
      </div>

      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} Beaumont-Wilshire Neighborhood Association. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <script>
    // On mobile, allow tapping a dropdown parent to toggle it open
    document.querySelectorAll('.has-dropdown > a').forEach(link => {
      link.addEventListener('click', (e) => {
        if (window.innerWidth <= 768) {
          const parent = link.parentElement;
          if (!parent.classList.contains('open')) {
            e.preventDefault();
            document.querySelectorAll('.has-dropdown.open').forEach(el => el.classList.remove('open'));
            parent.classList.toggle('open');
          }
        }
      });
    });
  </script>
</body>
</html>
