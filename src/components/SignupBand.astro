---
/*
 * "Stay in the Know!" blue band with the inline MailChimp signup form,
 * per the 2026 JF homepage mock. Same list as /subscribe.
 */
---

<section class="page-section cta-section signup-band">
  <div class="container">
    <h2>Stay in the Know!</h2>
    <p>
      Subscribe to receive monthly email updates about BWNA meetings, activities,
      and neighborhood news.
    </p>
    <form
      action="https://bwnapdx.us21.list-manage.com/subscribe/post?u=203722a9c2f8af9e6db5b3d86&amp;id=bc0c6760de&amp;f_id=00aad5e6f0"
      method="post"
      target="_blank"
      class="signup-form"
    >
      <p class="signup-required">* indicates required field</p>
      <div class="signup-fields">
        <div class="signup-field">
          <label for="signup-mce-EMAIL">Email Address *</label>
          <input type="email" name="EMAIL" id="signup-mce-EMAIL" required>
        </div>
        <div class="signup-field">
          <label for="signup-mce-FNAME">First Name</label>
          <input type="text" name="FNAME" id="signup-mce-FNAME">
        </div>
        <div class="signup-field">
          <label for="signup-mce-LNAME">Last Name</label>
          <input type="text" name="LNAME" id="signup-mce-LNAME">
        </div>
      </div>
      <div class="signup-honeypot" aria-hidden="true">
        <input type="text" name="b_203722a9c2f8af9e6db5b3d86_bc0c6760de" tabindex="-1" value="">
      </div>
      <button type="submit" class="btn signup-submit">Subscribe</button>
      <p class="signup-powered">Powered by MailChimp</p>
    </form>
  </div>
</section>

<style>
  .signup-form {
    max-width: 820px;
    margin: 0 auto;
  }

  .signup-required {
    font-size: 0.8rem;
    opacity: 0.9;
    margin-bottom: var(--spacing-sm);
  }

  .signup-fields {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-lg);
    text-align: left;
    margin-bottom: var(--spacing-lg);
  }

  @media (max-width: 640px) {
    .signup-fields {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }
  }

  .signup-field label {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 0.3rem;
  }

  .signup-field input {
    width: 100%;
    padding: 0.5rem 0.6rem;
    border: none;
    border-radius: 3px;
    font-size: 1rem;
    font-family: var(--font-family);
  }

  .signup-honeypot {
    position: absolute;
    left: -5000px;
  }

  .signup-submit {
    background: var(--color-accent);
    color: var(--color-primary-dark);
    font-size: 1.05rem;
  }

  .signup-submit:hover {
    background: white;
  }

  .signup-powered {
    font-size: 0.75rem;
    opacity: 0.8;
    margin-top: var(--spacing-md);
    margin-bottom: 0;
  }
</style>
