---
import type { Venue } from '../data/venues';

interface Props {
  venue: Venue;
  label: string;
}

const { venue, label } = Astro.props;
---

<div class="event-map" data-venue={JSON.stringify(venue)} data-label={label} role="img" aria-label={`Map showing ${label}`}></div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script is:inline>
  document.querySelectorAll('.event-map').forEach((el) => {
    const venue = JSON.parse(el.dataset.venue);
    const color = getComputedStyle(document.documentElement).getPropertyValue('--color-primary').trim() || '#006092';

    // Mostly static: no scroll-wheel or one-finger drag, so the map never traps page scrolling.
    const map = L.map(el, {
      scrollWheelZoom: false,
      dragging: !L.Browser.mobile,
      tap: false,
    });
    L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}', {
      maxZoom: 19,
      attribution: 'Tiles &copy; Esri',
    }).addTo(map);

    if (venue.point) {
      L.circleMarker(venue.point, { radius: 9, color: 'white', weight: 3, fillColor: color, fillOpacity: 1 })
        .bindTooltip(el.dataset.label, { direction: 'top', offset: [0, -8] })
        .addTo(map);
      map.setView(venue.point, 16);
    } else {
      const line = L.polyline(venue.line, { color, weight: 8, opacity: 0.85, lineCap: 'round' })
        .bindTooltip(el.dataset.label, { sticky: true })
        .addTo(map);
      map.fitBounds(line.getBounds(), { padding: [40, 40], maxZoom: 17 });
    }
  });
</script>

<style>
  .event-map {
    height: 280px;
    border-radius: 8px;
    margin-bottom: var(--spacing-xl);
    border: 1px solid var(--color-primary-light);
    z-index: 0;
  }
  :global(.event-map .leaflet-container) {
    font-family: inherit;
  }
</style>
