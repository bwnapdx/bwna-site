---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { toLocalDate } from '../../data/expandEvents';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map(event => ({
    params: { slug: event.id.replace(/\.md$/, '') },
    props: { event },
  }));
}

const { event } = Astro.props;
const { Content } = await event.render();
const base = import.meta.env.BASE_URL;

const typeColors: Record<string, string> = {
  meeting: '#1e5c3a',
  community: '#5c8a3e',
  social: '#8b5c3e',
  tour: '#6b4c8a',
};

function formatDate(date: Date, endDate?: Date) {
  const opts: Intl.DateTimeFormatOptions = { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' };
  if (endDate) {
    return `${date.toLocaleDateString('en-US', { month: 'long', day: 'numeric' })} \u2013 ${endDate.toLocaleDateString('en-US', opts)}`;
  }
  return date.toLocaleDateString('en-US', opts);
}
---

<BaseLayout title={event.data.title} description={event.data.summary || `${event.data.title} — a BWNA event`}>
  <article class="page-section" data-pagefind-body>
    <div class="container content-width">
      <div class="event-back">
        <a href={`${base}events`} class="text-sm">&larr; All Events</a>
      </div>

      <span class="event-type" style={`background: ${typeColors[event.data.type] || '#666'};`}>{event.data.type}</span>

      <h1>{event.data.title}</h1>

      {event.data.image && (
        <img
          src={event.data.image.startsWith('/') ? `${base}${event.data.image.slice(1)}` : event.data.image}
          alt={event.data.imageAlt || event.data.title}
          class="event-hero-img"
        />
      )}

      <div class="event-info-card">
        <div class="event-info-row">
          <strong>Date:</strong> {formatDate(toLocalDate(event.data.date), event.data.endDate ? toLocalDate(event.data.endDate) : undefined)}
        </div>
        <div class="event-info-row">
          <strong>Time:</strong> {event.data.time}
        </div>
        <div class="event-info-row">
          <strong>Location:</strong> {event.data.location}
          {event.data.address && (
            <a href={`https://maps.google.com/?q=${encodeURIComponent(event.data.address)}`}
               target="_blank" rel="noopener" class="text-sm"> (View Map)</a>
          )}
        </div>
      </div>

      {event.data.ticketUrl && (
        <a href={event.data.ticketUrl} target="_blank" rel="noopener" class="ticket-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/>
            <path d="M13 5v2"/><path d="M13 11v2"/><path d="M13 17v2"/>
          </svg>
          <span>Buy Tickets</span>
        </a>
      )}

      <div class="article-content">
        <Content />
      </div>
    </div>
  </article>

  <section class="page-section section-header">
    <div class="container">
      <a href={`${base}events`} class="btn btn-secondary">&larr; All Upcoming Events</a>
    </div>
  </section>
</BaseLayout>

<style>
  .event-back {
    margin-bottom: var(--spacing-lg);
  }

  .event-type {
    display: inline-block;
    color: white;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-size: 0.75rem;
    text-transform: uppercase;
    margin-bottom: var(--spacing-sm);
  }

  h1 {
    margin-bottom: var(--spacing-md);
  }

  .event-hero-img {
    width: 100%;
    border-radius: 8px;
    margin-bottom: var(--spacing-lg);
  }

  .event-info-card {
    background: var(--color-primary-light);
    border-radius: 8px;
    padding: var(--spacing-md) var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
  }

  .event-info-row {
    padding: var(--spacing-xs) 0;
  }

  .ticket-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background: var(--color-primary);
    color: white;
    padding: 0.7rem 1.5rem;
    border-radius: 8px;
    font-size: 1.05rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    margin-bottom: var(--spacing-xl);
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.2s ease;
  }

  .ticket-btn svg {
    flex-shrink: 0;
  }

  .ticket-btn:hover {
    background: var(--color-primary-dark);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.22);
    text-decoration: none;
  }

  .ticket-btn:active {
    transform: translateY(0);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
  }
</style>
