  { title: "General Meeting", date: "2020-02-10" },
  { title: "Special Board Meeting", date: "2020-01-29" },
  { title: "Board Meeting", date: "2020-01-13" },
  { title: "General Meeting", date: "2019-12-09" },
  { title: "Board Meeting", date: "2019-11-11" },
  { title: "General Meeting", date: "2019-10-14" },
  { title: "Board Meeting", date: "2019-09-09" },
  { title: "Board Meeting", date: "2019-07-08" },
];

// Derive filename from title + date
const minutes = minutesData.map(m => ({
  ...m,
  file: `${m.title.toLowerCase().replace(/ /g, '-')}-${m.date}.pdf`,
}));

// Group by year
const byYear: Record<string, typeof minutes> = {};
for (const m of minutes) {
  const year = m.date.split('-')[0];
  (byYear[year] ??= []).push(m);
}

function formatDate(dateStr: string) {
  const d = new Date(dateStr + 'T12:00:00');
  return d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}
---

<BaseLayout title="Meeting Minutes" description="BWNA meeting minutes archive from 2019 to present.">
  <section class="hero">
    <div class="container">
      <h1>Meeting Minutes</h1>
      <p>Records of BWNA meetings</p>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-width">
      <p>
        Meeting minutes from BWNA general meetings and board meetings are approved at the
        following meeting and then made available here.
      </p>

      {Object.entries(byYear).sort(([a], [b]) => Number(b) - Number(a)).map(([year, items], index) => (
        <details class="year-group" open={index === 0}>
          <summary class="year-heading">{year} <span class="year-count">({items.length} meetings)</span></summary>
          <ul class="newsletter-list">
            {items.map(m => (
              <li>
                <span>
                  <span class="meeting-type">{m.title}</span>
                  <span class="text-muted"> — {formatDate(m.date)}</span>
                </span>
                <a href={`${base}documents/meeting-minutes/${m.file}`} target="_blank" rel="noopener" class="download-link">
                  <span>Download PDF</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                    <polyline points="7 10 12 15 17 10"/>
                    <line x1="12" y1="15" x2="12" y2="3"/>
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </details>
      ))}
    </div>
  </section>

  <section class="page-section">
    <div class="container content-width">
      <div class="card card--highlight">
        <h3>Meeting Schedule</h3>
        <p><strong>General Meetings:</strong> 2nd Monday of even-numbered months (Feb, Apr, Jun, Aug, Oct, Dec)</p>
        <p><strong>Board Meetings:</strong> 2nd Monday of odd-numbered months (Jan, Mar, May, Jul, Sep, Nov)</p>
        <p><strong>Location:</strong> Sylvan Learning Center, 4300 NE Fremont St, Suite 150</p>
      </div>
      <p class="back-link">
        <a href={`${base}events`}>View upcoming meetings &rarr;</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .meeting-type {
    font-weight: 600;
  }
</style>
