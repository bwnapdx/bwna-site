---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Meeting Minutes" description="BWNA meeting minutes archive.">
  <section class="hero" style="padding: 2rem 0;">
    <div class="container">
      <h1>Meeting Minutes</h1>
      <p>Records of BWNA meetings</p>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-width">
      <p>
        Meeting minutes from BWNA general meetings and board meetings are approved at the
        following meeting and then made available here.
      </p>
      <p>
        To request copies of past minutes, please contact
        <a href="mailto:president@bwnapdx.org">president@bwnapdx.org</a>.
      </p>
      <div class="card" style="background: var(--color-primary-light); margin-top: 2rem;">
        <h3>Meeting Schedule</h3>
        <p><strong>General Meetings:</strong> 2nd Monday of even-numbered months (Feb, Apr, Jun, Aug, Oct, Dec)</p>
        <p><strong>Board Meetings:</strong> 2nd Monday of odd-numbered months (Jan, Mar, May, Jul, Sep, Nov)</p>
        <p style="margin-bottom: 0;"><strong>Location:</strong> Sylvan Learning Center, 4411 NE Fremont St</p>
      </div>
      <p style="margin-top: 1.5rem;">
        <a href={`${base}events`}>View upcoming meetings &rarr;</a>
      </p>
    </div>
  </section>
</BaseLayout>
