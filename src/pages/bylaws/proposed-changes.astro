---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ObfuscatedEmail from '../../components/ObfuscatedEmail.astro';
// Generated by scripts/bylaws-redline.py from the proposal .docx and the adopted PDF.
// Rerun the script when a new draft arrives; don't hand-edit the JSON.
import redline from '../../data/bylaws-proposed.json';

const base = import.meta.env.BASE_URL;

// `current` is set when the two sources spell an unchanged word differently (city's / city’s).
type Run = { op: 'eq' | 'ins' | 'del'; text: string; current?: string };
type Article = { number: number; title: string; currentTitle: string; changed: boolean; paragraphs: Run[][] };
const articles = redline.articles as Article[];

// Headings in the bylaws ("Section 4: Agenda") render bold so the long text is scannable.
const isHeading = (p: Run[]) => /^Section \d+[:.]?\s/.test(p.map(r => r.text).join(' ')) && p.map(r => r.text).join(' ').length < 70;

// Plain-language summary, drawn from the authors' explanation to the board (Sept. 29, 2026).
const highlights = [
  {
    title: 'One kind of monthly meeting',
    where: 'Article 6, Section 1; Article 3, Section 2',
    anchor: 'article-6',
    body: 'Today the bylaws alternate between "general" meetings (February, April, June, October, December) and "board" meetings (the other months). The only real difference between them is the Open Floor segment. The revision makes every monthly meeting a General Meeting, with Open Floor time in even-numbered months, as it is now.',
  },
  {
    title: '"Members" becomes "residents and eligible non-residents"',
    where: 'Article 3, Section 1, and throughout',
    anchor: 'article-3',
    body: 'The current bylaws use "members" for everyone eligible to vote on elections, bylaws, and dissolution, but also say "board members" in places. To clear up the confusion, the revision spells it out: residents 18 and older, plus one representative each from property owners, businesses, agencies, and nonprofits located in the neighborhood ("eligible non-residents").',
  },
  {
    title: 'Joining on Zoom counts',
    where: 'Article 3, Section 2 (C, F, G)',
    anchor: 'article-3',
    body: 'People attending a meeting online in real time are officially in attendance and may vote, whether the whole meeting is online or they are joining an in-person meeting remotely.',
  },
  {
    title: 'Board retreats are defined',
    where: 'Article 6, Section 2 (C)',
    anchor: 'article-6',
    body: 'Annual board retreats are added under Board Meetings, including who takes part (board members and committee chairs, who need not be on the board) and that motions can be discussed and voted on.',
  },
  {
    title: 'New terms start in May',
    where: 'Article 9, Section 4',
    anchor: 'article-9',
    body: 'Board members and officers elected at the April General Meeting take up their duties at the May meeting.',
  },
];

const smallerChanges = [
  'Agenda requests must reach the person preparing the agenda at least eight days before the meeting, and that person decides whether to add them (Article 6, Section 4).',
  'Special Meetings are limited to a single announced topic (Article 6, Section 1).',
  'The Northeast Coalition of Neighborhoods (NECN) is named wherever the bylaws referred to "the District Coalition" (throughout).',
  'Notice of a proposed bylaws amendment must go out at least seven days before the meeting where it is considered (Article 12).',
];

const changedCount = articles.filter(a => a.changed).length;
---

<BaseLayout
  title="Proposed Bylaws Revisions"
  description="Proposed revisions to the BWNA Bylaws: what would change, why, and the full text with every change marked."
>
  <section class="hero">
    <div class="container">
      <h1>Proposed Bylaws Revisions</h1>
      <p>A draft for neighbors to review before the board takes it to a vote</p>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-width">
      <div class="status-card">
        <p>
          <strong>Status: draft.</strong> Vice President Tim Gillespie and President Al Ellis prepared
          these revisions to the <a href={`${base}bylaws`}>bylaws adopted December 9, 2024</a>, and
          updated them after board discussion at the September 14, 2026 meeting. A vote is planned
          for the <strong>November 9, 2026</strong> meeting. Wording may still change before then;
          this page will be updated to match.
        </p>
        <p>
          Amending the bylaws takes a two-thirds vote of the eligible neighbors present at the
          meeting where the amendment is considered (Article 12).
        </p>
      </div>

      <h2>What would change</h2>
      <p>
        Most of the revision is housekeeping: clearer terms, current names, and rules that match how
        BWNA already runs. The changes that matter most:
      </p>
      <ol class="highlights">
        {highlights.map(h => (
          <li>
            <h4>{h.title}</h4>
            <p>{h.body}</p>
            <p class="text-sm where"><a href={`#${h.anchor}`}>{h.where}</a></p>
          </li>
        ))}
      </ol>

      <h3>Smaller changes</h3>
      <ul class="spaced-list">
        {smallerChanges.map(c => <li>{c}</li>)}
      </ul>

      <h3>Questions or comments?</h3>
      <p>
        Come to a meeting (see <a href={`${base}events`}>Upcoming Events</a>) or
        <ObfuscatedEmail email="info@bwnapdx.org" label="email BWNA" />. All meetings are open to
        the public, in person or on Zoom.
      </p>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-width">
      <h2>Full text, existing and proposed</h2>
      <p>
        Every change is marked below, word for word. {changedCount} of {articles.length} articles have
        changes. Switch views to read the current or proposed bylaws on their own.
      </p>

      <div class="redline-controls" role="group" aria-label="Bylaws view">
        <button type="button" data-view="redline" aria-pressed="true">Changes marked</button>
        <button type="button" data-view="proposed" aria-pressed="false">Proposed text</button>
        <button type="button" data-view="current" aria-pressed="false">Current text</button>
      </div>
      <p class="legend text-sm" data-legend>
        <ins>Added text</ins> &nbsp; <del>Removed text</del>
      </p>

      <nav class="article-index text-sm" aria-label="Articles">
        {articles.map(a => (
          <a href={`#article-${a.number}`} class:list={{ unchanged: !a.changed }}>
            {a.number}. {a.title}{!a.changed && ' (no changes)'}
          </a>
        ))}
      </nav>

      <div class="redline" data-view="redline" id="redline">
        {articles.map(a => (
          <section class="article" id={`article-${a.number}`}>
            <h3>
              Article {a.number}:{' '}
              {a.currentTitle && a.currentTitle !== a.title ? (
                <><del>{a.currentTitle}</del> <ins>{a.title}</ins></>
              ) : a.title}
              {!a.changed && <span class="no-change text-sm">No changes</span>}
            </h3>
            {a.paragraphs.map(p => (
              <p class:list={{ 'bylaw-heading': isHeading(p) }}>
                {p.map((r, i) => (
                  <>{i > 0 && ' '}{r.op === 'ins' ? <ins>{r.text}</ins> : r.op === 'del' ? <del>{r.text}</del> : r.current ? <><span class="v-proposed">{r.text}</span><span class="v-current">{r.current}</span></> : r.text}</>
                ))}
              </p>
            ))}
          </section>
        ))}
      </div>

      <p class="text-sm source-note">
        Source: {redline.source}, compared against the <a href={`${base}documents/bwna-bylaws.pdf`}>adopted bylaws (PDF)</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  const root = document.getElementById('redline');
  const legend = document.querySelector<HTMLElement>('[data-legend]');
  const buttons = document.querySelectorAll<HTMLButtonElement>('.redline-controls button');
  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const view = btn.dataset.view!;
      root?.setAttribute('data-view', view);
      buttons.forEach(b => b.setAttribute('aria-pressed', String(b === btn)));
      if (legend) legend.hidden = view !== 'redline';
    });
  });
</script>

<style>
  .content-width > h2:not(:first-child) {
    margin-top: var(--spacing-2xl);
  }

  .content-width > h3:not(:first-child) {
    margin-top: var(--spacing-xl);
  }

  .status-card {
    background: var(--color-primary-light);
    border-left: 4px solid var(--color-primary);
    border-radius: 6px;
    padding: var(--spacing-md) var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
  }

  .status-card p:last-child {
    margin-bottom: 0;
  }

  .highlights {
    margin-left: 1.5rem;
  }

  .highlights li {
    margin-bottom: var(--spacing-lg);
  }

  .highlights h4 {
    margin-bottom: var(--spacing-xs);
  }

  .highlights p {
    margin-bottom: 0.25rem;
  }

  .where {
    color: var(--color-text-light);
  }

  .redline-controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    margin: var(--spacing-lg) 0 var(--spacing-sm);
  }

  .redline-controls button {
    font: inherit;
    font-size: 0.9rem;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--color-primary);
    border-radius: 999px;
    background: white;
    color: var(--color-primary);
    cursor: pointer;
  }

  .redline-controls button[aria-pressed='true'] {
    background: var(--color-primary);
    color: white;
  }

  .article-index {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: var(--spacing-md) 0 var(--spacing-xl);
    padding: var(--spacing-md);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: white;
  }

  .article-index .unchanged {
    color: var(--color-text-light);
  }

  .article {
    scroll-margin-top: 5rem;
    padding-top: var(--spacing-lg);
    border-top: 1px solid var(--color-border);
    margin-top: var(--spacing-lg);
  }

  .article h3 {
    margin-top: 0;
  }

  .no-change {
    margin-left: 0.5rem;
    font-weight: normal;
    color: var(--color-text-light);
  }

  .bylaw-heading {
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  ins,
  del {
    text-decoration-thickness: 1px;
    border-radius: 2px;
    padding: 0 1px;
  }

  ins {
    background: #dff3e4;
    color: #14532d;
    text-decoration: underline;
  }

  del {
    background: #fde8e8;
    color: #8a1c1c;
    text-decoration: line-through;
    opacity: 0.7;
  }

  .redline[data-view='proposed'] del,
  .redline[data-view='current'] ins {
    display: none;
  }

  .redline[data-view='proposed'] ins,
  .redline[data-view='current'] del {
    background: none;
    color: inherit;
    text-decoration: none;
    padding: 0;
    opacity: 1;
  }

  .v-current,
  .redline[data-view='current'] .v-proposed {
    display: none;
  }

  .redline[data-view='current'] .v-current {
    display: inline;
  }

  .source-note {
    margin-top: var(--spacing-xl);
    color: var(--color-text-light);
  }
</style>
