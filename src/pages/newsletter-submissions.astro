---
import BaseLayout from '../layouts/BaseLayout.astro';
import ObfuscatedEmail from '../components/ObfuscatedEmail.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Newsletter Submissions" description="Submit content for the BWNA newsletter.">
  <section class="hero">
    <div class="container">
      <h1>Newsletter Submissions</h1>
      <p>Contribute to the BWNA newsletter</p>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-width">
      <p>
        The BWNA newsletter welcomes letters, editorials, articles, and announcements from
        neighbors. If you have a story, event, or announcement to share with the community,
        we'd love to hear from you!
      </p>

      <h2>Submission Guidelines</h2>
      <ul class="spaced-list">
        <li>Articles should be relevant to the Beaumont-Wilshire neighborhood.</li>
        <li>Maximum word count is 250.</li>
        <li>MS Word is the preferred document type; high-resolution images in jpeg or png format.</li>
        <li>Submissions are subject to editing for length and clarity.</li>
        <li>
          Deadline is typically 4 weeks before the issue date, e.g., December 1 for the
          January-February newsletter. (Due to space limitations, submission does not
          guarantee placement).
        </li>
        <li>
          Email all submissions or questions to
          <ObfuscatedEmail email="editor@bwnapdx.org" label="the editor" />.
        </li>
      </ul>

      <p class="back-link">
        <a href={`${base}newsletters`}>&larr; Back to Newsletters</a>
      </p>
    </div>
  </section>
</BaseLayout>
