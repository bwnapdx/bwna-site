---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categoryLabels } from '../../data/categoryLabels';
import { isPortraitImage } from '../../utils/imageOrientation.js';

export async function getStaticPaths() {
  const articles = await getCollection('newsletters');
  return Promise.all(articles.map(async article => ({
    params: { slug: article.id.replace(/\.md$/, '') },
    props: {
      article,
      allArticles: articles,
      heroPortrait: await isPortraitImage(article.data.image),
    },
  })));
}

const { article, allArticles, heroPortrait } = Astro.props;
const { Content } = await article.render();
const base = import.meta.env.BASE_URL;

// Get other articles from the same issue
const issueArticles = allArticles
  .filter(a => a.data.issueSlug === article.data.issueSlug && a.id.replace(/\.md$/, '') !== article.id)
  .sort((a, b) => (a.data.page ?? 99) - (b.data.page ?? 99));
---

<BaseLayout title={article.data.title} description={`${article.data.title} — from the ${article.data.issue} BWNA Newsletter`}>
  <article class="page-section" data-pagefind-body>
    <div class="container content-width article-layout">
      <div class="article-back">
        <a href={`${base}newsletters`} class="text-sm">&larr; {article.data.issue} Newsletter</a>
      </div>

      <div class="article-meta-row">
        <span class="category-badge" data-pagefind-filter="category">{categoryLabels[article.data.category] || article.data.category}</span>
        <span class="text-sm text-muted">{article.data.issue}</span>
      </div>

      <h1 data-pagefind-meta="title">{article.data.title}</h1>

      {article.data.author && (
        <p class="article-author" data-pagefind-meta="author">
          By {article.data.author}
        </p>
      )}

      {article.data.editorsNote && (
        <aside class="editors-note" data-pagefind-ignore>
          <strong>Editor's note:</strong> {article.data.editorsNote}
        </aside>
      )}

      {article.data.image && (
        <figure class:list={["article-hero-image", { "article-hero-image--portrait": heroPortrait }]}>
          <img src={`${base}${article.data.image.replace(/^\//, '')}`} alt={article.data.imageAlt || ''} />
          {article.data.imageAlt && <figcaption>{article.data.imageAlt}</figcaption>}
        </figure>
      )}

      <div class="article-content">
        <Content />
      </div>

      {article.data.gallery && article.data.gallery.length > 0 && (
        <div class="article-gallery">
          {article.data.gallery.map(img => (
            <figure class:list={[{ "gallery-wide": img.wide }]}>
              <img src={`${base}${img.src.replace(/^\//, '')}`} alt={img.alt || ''} />
              {img.caption && <figcaption>{img.caption}</figcaption>}
            </figure>
          ))}
        </div>
      )}

      {article.data.pdfFile && (
        <div class="card card--highlight issue-card">
          <p>
            This article appeared in the <strong>{article.data.issue}</strong> issue of the BWNA Newsletter.
          </p>
          <p class="text-sm text-muted archive-disclaimer">
            Articles in our archive are text-extracted from the original newsletter PDFs;
            photos, ads, and layout aren't included. Download the issue below for the
            full experience.
          </p>
          <a href={`${base}newsletters/${article.data.pdfFile}`} target="_blank" rel="noopener" class="download-link">
            Download complete issue (PDF)
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
          </a>
        </div>
      )}
    </div>
  </article>

  {issueArticles.length > 0 && (
    <section class="page-section related-section">
      <div class="container content-width">
        <h2 class="related-heading">More from {article.data.issue}</h2>
        <ul class="related-list">
          {issueArticles.map(a => (
            <li>
              <a href={`${base}newsletters/${a.id.replace(/\.md$/, '')}`} class="related-link">
                <span>
                  <strong>{a.data.title}</strong>
                  {a.data.author && <span class="text-sm text-muted"> — {a.data.author}</span>}
                </span>
                <span class="category-badge category-badge--sm">{categoryLabels[a.data.category] || a.data.category}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .article-back {
    margin-bottom: var(--spacing-lg);
  }

  .article-meta-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: var(--spacing-sm);
    flex-wrap: wrap;
  }

  h1 {
    margin-bottom: var(--spacing-sm);
  }

  .article-author {
    color: var(--color-text-light);
    margin-bottom: var(--spacing-xl);
    font-size: 0.95rem;
  }

  .editors-note {
    background: var(--color-background-alt);
    border-left: 3px solid var(--color-primary);
    padding: 0.875rem 1.125rem;
    margin-bottom: var(--spacing-lg);
    font-size: 0.95rem;
    color: var(--color-text-light);
    border-radius: 0 4px 4px 0;
  }

  .editors-note strong {
    color: var(--color-text);
  }

  .article-layout {
    /* Contain the floated portrait hero so it can't overlap later sections. */
    display: flow-root;
  }

  .article-hero-image {
    margin-bottom: var(--spacing-lg);
  }

  .article-hero-image img {
    display: block;
    width: 100%;
    height: auto;          /* preserve natural aspect ratio — never crop */
    border-radius: 6px;
  }

  /* Tall portrait photos float alongside the text instead of stretching
     full-width, which would otherwise crop them or tower over the page. */
  .article-hero-image--portrait {
    float: right;
    width: min(45%, 320px);
    margin: 0.25rem 0 var(--spacing-md) var(--spacing-lg);
  }

  @media (max-width: 640px) {
    .article-hero-image--portrait {
      float: none;
      width: 100%;
      max-width: 320px;
      margin: 0 auto var(--spacing-lg);
    }
  }

  .article-hero-image figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-light);
    font-style: italic;
  }

  /* Photo-essay gallery: responsive captioned grid. */
  .article-gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-lg);
    align-items: start;
    margin: var(--spacing-xl) 0;
  }

  .article-gallery figure {
    margin: 0;
  }

  .article-gallery .gallery-wide {
    grid-column: 1 / -1;
  }

  .article-gallery img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
  }

  .article-gallery figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-light);
    font-style: italic;
  }

  @media (max-width: 640px) {
    .article-gallery {
      grid-template-columns: 1fr;
    }
  }

  .issue-card {
    margin-top: 2.5rem;
  }

  .issue-card p {
    margin-bottom: var(--spacing-sm);
  }

  .archive-disclaimer {
    font-style: italic;
  }

  .related-section {
    background: var(--color-background-alt);
  }

  .related-heading {
    font-size: 1.25rem;
    margin-bottom: var(--spacing-md);
  }

  .related-list {
    list-style: none;
    padding: 0;
  }

  .related-list li {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .related-list li:last-child {
    border-bottom: none;
  }

  .related-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    color: inherit;
  }

  .related-link:hover {
    text-decoration: none;
  }

  .related-link:hover strong {
    text-decoration: underline;
  }

</style>
