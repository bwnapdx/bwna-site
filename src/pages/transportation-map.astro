---
import BaseLayout from '../layouts/BaseLayout.astro';
import ObfuscatedEmail from '../components/ObfuscatedEmail.astro';
import MapFrame from '../components/MapFrame.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Neighborhood Transportation Map" description="An interactive map of how people get around Beaumont-Wilshire and Portland: crashes, High Crash Network streets, bike routes, transit, traffic speeds, crossings, and paving.">
  <section class="hero">
    <div class="container">
      <h1>Neighborhood Transportation Map</h1>
      <p>Streets, safety, and getting around in Beaumont-Wilshire</p>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-width">
      <p>
        Built by Transportation Committee chair Graeme Rudd from city, regional, and state data,
        this map gives neighbors a shared picture of how people get around Beaumont-Wilshire and
        where the trouble spots are. Use the layers panel to switch on:
      </p>
      <ul class="spaced-list">
        <li>Crash records since 2007, shown by severity or as a heat map</li>
        <li>Streets and intersections on PBOT's High Crash Network, such as NE Fremont</li>
        <li>Measured traffic speeds and speed limits</li>
        <li>Neighborhood greenways, bike routes, and Safe Routes to School</li>
        <li>TriMet Frequent Service and MAX lines</li>
        <li>Crosswalks, crossing beacons, curb ramps, and gaps in the sidewalk network</li>
        <li>Street paving condition and upcoming city projects</li>
      </ul>
      <p>
        The dashboard compares Beaumont-Wilshire with other Portland neighborhoods and Portland
        with other cities. Click any line or dot for details. The map loads live from the
        agencies that publish the data, so a layer can take a few seconds to appear.
      </p>
    </div>

    <MapFrame slug="transportation" title="Interactive Beaumont-Wilshire transportation map" />

    <div class="container content-width">
      <p>
        See also the <a href={`${base}safety-land-use-map`}>Public Safety &amp; Land Use Map</a>,
        covering crime reports, zoning, natural hazards, and emergency resources.
      </p>
      <p>
        Have thoughts about transportation in the neighborhood, or see something the map
        should show?
        <ObfuscatedEmail email="info@bwnapdx.org" label="Contact the Transportation Committee" />,
        or learn more about BWNA's <a href={`${base}committees#transportation`}>committees</a>.
      </p>
    </div>
  </section>
</BaseLayout>
