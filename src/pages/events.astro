---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { expandEvents, toLocalDate, type ExpandedEvent } from '../data/expandEvents';

const base = import.meta.env.BASE_URL;

const allEvents = await getCollection('events');
const expanded = expandEvents(allEvents);

// Hero: the single next upcoming featured event (expanded is date-sorted, so the
// first match is the soonest). It's shown once as a hero card and excluded from
// the month list below so it never appears twice.
const nextFeatured = expanded.find(e => e.entry.data.featured && !e.entry.data.recurring) ?? null;
const listEvents = nextFeatured
  ? expanded.filter(e => e.entry.id !== nextFeatured.entry.id)
  : expanded;

const months = ['January', 'February', 'March', 'April', 'May', 'June',
                'July', 'August', 'September', 'October', 'November', 'December'];
const monthsShort = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

const now = new Date();

// Group all events by month, chronologically interleaved across scopes
const scopeLabels: Record<string, string> = {
  bwna: 'BWNA',
  neighborhood: 'Neighborhood',
  city: 'Citywide',
};

const monthGroups: { key: string; label: string; events: ExpandedEvent[] }[] = [];
const monthIndex = new Map<string, number>();
for (const ev of listEvents) {
  const key = `${ev.date.getFullYear()}-${ev.date.getMonth()}`;
  let idx = monthIndex.get(key);
  if (idx === undefined) {
    idx = monthGroups.length;
    monthIndex.set(key, idx);
    monthGroups.push({
      key,
      label: `${months[ev.date.getMonth()]} ${ev.date.getFullYear()}`,
      events: [],
    });
  }
  monthGroups[idx].events.push(ev);
}

const typeColors: Record<string, string> = {
  meeting: '#1e5c3a',
  community: '#5c8a3e',
  social: '#8b5c3e',
  tour: '#6b4c8a',
};

function formatDate(date: Date, endDate?: Date) {
  const opts: Intl.DateTimeFormatOptions = { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' };
  if (endDate) {
    return `${date.toLocaleDateString('en-US', { month: 'long', day: 'numeric' })} - ${endDate.toLocaleDateString('en-US', opts)}`;
  }
  return date.toLocaleDateString('en-US', opts);
}

function hasBody(body: string) {
  return body.trim().length > 10;
}

// Calendar bounds: current month through the month of the last event
const lastEventDate = expanded.length > 0
  ? expanded[expanded.length - 1].date
  : now;
const calMinYear = now.getFullYear();
const calMinMonth = now.getMonth();
const calMaxYear = lastEventDate.getFullYear();
const calMaxMonth = lastEventDate.getMonth();

// Emit a timezone-stable YYYY-MM-DD from each event's (local-midnight) date so
// the client calendar plots it on the intended calendar day regardless of the
// build machine's timezone. GitHub Actions builds in UTC, where toISOString()
// yields e.g. "2026-07-13T00:00:00Z" and the client's local getters would read
// that back as July 12 in Portland — shifting every event to the day before.
const pad = (n: number) => String(n).padStart(2, '0');
const ymd = (d: Date) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;

// Prepare event data for the calendar (JSON-serializable)
const calendarEvents = expanded.map(e => ({
  title: e.entry.data.title,
  date: ymd(e.date),
  endDate: e.entry.data.endDate ? ymd(toLocalDate(e.entry.data.endDate)) : undefined,
  time: e.entry.data.time,
  location: e.entry.data.location,
  type: e.entry.data.type,
  scope: e.entry.data.scope,
  summary: e.entry.data.summary || '',
  url: !e.entry.data.recurring && hasBody(e.entry.body || '') ? `${base}events/${e.entry.id.replace(/\.md$/, '')}` : '',
}));
---

<BaseLayout title="Upcoming Events" description="Find upcoming BWNA meetings, community events, and neighborhood activities in Beaumont-Wilshire.">

  <section class="hero">
    <div class="container">
      <h1>Upcoming Events</h1>
      <p>Meetings, activities, and gatherings in Beaumont-Wilshire</p>
    </div>
  </section>

  <!-- Side-by-side layout: calendar + event list -->
  <section class="page-section">
    <div class="container">
      <div class="events-layout">

        <!-- Event list (left/main) -->
        <div class="events-list">

          {nextFeatured && (
            <div class="featured-section">
              <span class="featured-label">Next featured event</span>
              <a href={`${base}events/${nextFeatured.entry.id.replace(/\.md$/, '')}`} class="featured-event">
                {nextFeatured.entry.data.image && (
                  <img src={nextFeatured.entry.data.image.startsWith('/') ? `${base}${nextFeatured.entry.data.image.slice(1)}` : nextFeatured.entry.data.image} alt={nextFeatured.entry.data.imageAlt || nextFeatured.entry.data.title} class="featured-event-img" />
                )}
                <div class="featured-event-content">
                  <span class="event-type" style={`background: ${typeColors[nextFeatured.entry.data.type] || '#666'};`}>{nextFeatured.entry.data.type}</span>
                  <h2>{nextFeatured.entry.data.title}</h2>
                  <div class="event-meta">
                    {formatDate(nextFeatured.date, nextFeatured.entry.data.endDate ? toLocalDate(nextFeatured.entry.data.endDate) : undefined)} &middot; {nextFeatured.entry.data.time}
                  </div>
                  <div class="event-meta">{nextFeatured.entry.data.location}</div>
                  {nextFeatured.entry.data.summary && <p>{nextFeatured.entry.data.summary}</p>}
                  <span class="btn btn-secondary">View Details &rarr;</span>
                </div>
              </a>
            </div>
          )}
          {monthGroups.map(({ key, label, events: monthEvents }) => (
            <div class="month-group">
              <h2 class="month-heading">{label}</h2>

              {monthEvents.map((ev) => (
                <div class="event-item event-item--bordered">
                  <div class="event-date">
                    <div class="month">{monthsShort[ev.date.getMonth()]}</div>
                    <div class="day">{ev.date.getDate()}</div>
                  </div>
                  <div class="event-details">
                    <div class="event-header">
                      <h3>
                        {!ev.entry.data.recurring && hasBody(ev.entry.body || '') ? (
                          <a href={`${base}events/${ev.entry.id.replace(/\.md$/, '')}`}>{ev.entry.data.title}</a>
                        ) : (
                          ev.entry.data.title
                        )}
                      </h3>
                      <div class="event-tags">
                        {ev.entry.data.scope !== 'bwna' && (
                          <span class="event-scope">{scopeLabels[ev.entry.data.scope]}</span>
                        )}
                        <span class="event-type" style={`background: ${typeColors[ev.entry.data.type] || '#666'};`}>
                          {ev.entry.data.type}
                        </span>
                      </div>
                    </div>
                    <div class="event-meta">
                      {ev.entry.data.time} &nbsp;|&nbsp; {ev.entry.data.location}
                    </div>
                    {ev.entry.data.summary && <p>{ev.entry.data.summary}</p>}
                    <div class="event-links">
                      {ev.entry.data.ticketUrl && (
                        <a href={ev.entry.data.ticketUrl} target="_blank" rel="noopener" class="event-ticket-link">Buy Tickets</a>
                      )}
                      {ev.entry.data.address && (
                        <a href={`https://maps.google.com/?q=${encodeURIComponent(ev.entry.data.address)}`}
                           target="_blank"
                           rel="noopener"
                           class="text-sm">
                          View on Map
                        </a>
                      )}
                      {!ev.entry.data.recurring && hasBody(ev.entry.body || '') && (
                        <a href={`${base}events/${ev.entry.id.replace(/\.md$/, '')}`} class="text-sm">Details &rarr;</a>
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          ))}

          {expanded.length === 0 && (
            <p class="text-muted">No upcoming events scheduled. Check back soon!</p>
          )}
        </div>

        <!-- Calendar sidebar (right on desktop, top on mobile) -->
        <div class="events-calendar">
          <div class="calendar-sticky">
            <div class="calendar-nav">
              <button class="calendar-nav-btn" id="cal-prev">&larr;</button>
              <h3 class="calendar-month-label" id="cal-label"></h3>
              <button class="calendar-nav-btn" id="cal-next">&rarr;</button>
            </div>
            <div class="calendar-grid">
              <div class="calendar-header">Su</div>
              <div class="calendar-header">Mo</div>
              <div class="calendar-header">Tu</div>
              <div class="calendar-header">We</div>
              <div class="calendar-header">Th</div>
              <div class="calendar-header">Fr</div>
              <div class="calendar-header">Sa</div>
            </div>
            <div class="calendar-days" id="cal-days"></div>
            <div class="calendar-detail" id="cal-detail"></div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="page-section section-header">
    <div class="container">
      <h3>Have a neighborhood event to share?</h3>
      <p>Contact us to have your community event listed on our calendar.</p>
      <a href="mailto:editor@bwnapdx.org" class="btn btn-secondary">Submit an Event</a>
    </div>
  </section>
</BaseLayout>

<style>
  .featured-label {
    display: inline-block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary-dark);
    background: var(--color-primary-light);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    margin-bottom: var(--spacing-sm);
  }

  .featured-event {
    display: block;
    border: 2px solid var(--color-primary);
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s;
    margin-bottom: var(--spacing-xl);
  }

  .featured-event:hover {
    box-shadow: 0 4px 16px rgba(30, 92, 58, 0.15);
    text-decoration: none;
  }

  .featured-event-img {
    width: 100%;
    height: 250px;
    object-fit: cover;
  }

  .featured-event-content {
    padding: var(--spacing-lg);
  }

  .featured-event-content h2 {
    margin-bottom: var(--spacing-sm);
  }

  .featured-event-content p {
    margin-bottom: var(--spacing-md);
  }

  /* Side-by-side layout */
  .events-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 400px;
    gap: var(--spacing-xl);
    align-items: start;
  }

  .month-group {
    margin-bottom: var(--spacing-2xl);
  }

  .month-heading {
    font-size: 1.5rem;
    color: var(--color-primary-dark);
    margin-bottom: var(--spacing-lg);
    padding-bottom: 0.5rem;
    border-bottom: 3px solid var(--color-primary);
  }

  .event-item--bordered {
    background: white;
    border: 1px solid var(--color-border);
  }

  .event-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .event-header h3 {
    margin-bottom: var(--spacing-xs);
  }

  .event-header h3 a {
    color: var(--color-primary-dark);
  }

  .event-header h3 a:hover {
    text-decoration: underline;
  }

  .event-tags {
    display: flex;
    gap: 0.35rem;
    flex-shrink: 0;
    flex-wrap: wrap;
  }

  .event-type {
    color: white;
    padding: 0.125rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .event-scope {
    color: var(--color-text-light);
    background: var(--color-background-alt);
    border: 1px solid var(--color-border);
    padding: 0.125rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    flex-shrink: 0;
  }

  .event-links {
    display: flex;
    gap: var(--spacing-md);
    margin-top: var(--spacing-xs);
    align-items: center;
  }

  .event-ticket-link {
    display: inline-block;
    background: var(--color-primary);
    color: white;
    padding: 0.2rem 0.7rem;
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
  }

  .event-ticket-link:hover {
    background: var(--color-primary-dark);
    text-decoration: none;
  }

  /* Calendar sidebar */
  .calendar-sticky {
    position: sticky;
    top: 80px;
  }

  .events-calendar {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: var(--spacing-lg);
    background: white;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .calendar-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--spacing-sm);
  }

  .calendar-nav-btn {
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.25rem 0.5rem;
    font-size: 0.9rem;
    cursor: pointer;
    color: var(--color-primary);
    transition: background 0.2s;
  }

  .calendar-nav-btn:hover {
    background: var(--color-primary-light);
  }

  .calendar-nav-btn:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .calendar-nav-btn:disabled:hover {
    background: none;
  }

  .calendar-month-label {
    font-size: 1.15rem;
    text-align: center;
    margin: 0;
  }

  .calendar-grid,
  .calendar-days {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
  }

  .calendar-header {
    text-align: center;
    font-weight: 600;
    font-size: 0.75rem;
    color: var(--color-text-light);
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .calendar-days :global(.cal-day) {
    min-height: 52px;
    padding: 0.3rem;
    border: 1px solid var(--color-border);
    border-top: none;
    font-size: 0.85rem;
    cursor: default;
    text-align: center;
    position: relative;
  }

  .calendar-days :global(.cal-day.empty) {
    background: var(--color-background-alt);
  }

  .calendar-days :global(.cal-day.today) {
    background: var(--color-primary-light);
  }

  .calendar-days :global(.cal-day.has-events) {
    cursor: pointer;
  }

  .calendar-days :global(.cal-day.has-events:hover) {
    background: #f0f7f0;
  }

  .calendar-days :global(.cal-day.selected) {
    outline: 2px solid var(--color-primary);
    outline-offset: -2px;
  }

  .calendar-days :global(.cal-day-num) {
    font-weight: 500;
    display: block;
  }

  .calendar-days :global(.cal-dots) {
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
    justify-content: center;
    margin-top: 2px;
  }

  .calendar-days :global(.cal-dot) {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  /* Hover popover on calendar days. No gap between day & popover so the cursor
     can move in without losing :hover. */
  .calendar-days :global(.cal-popover) {
    position: absolute;
    bottom: calc(100% - 1px);
    left: 50%;
    transform: translateX(-50%);
    min-width: 200px;
    max-width: 260px;
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
    padding: 0.55rem 0.7rem;
    margin-bottom: 6px;
    font-size: 0.8rem;
    text-align: left;
    z-index: 50;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.12s ease;
    pointer-events: none;
  }

  /* Invisible bridge so cursor can travel from day cell into the popover
     without crossing dead space. */
  .calendar-days :global(.cal-popover::after) {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 8px;
  }

  .calendar-days :global(.cal-day.has-events:hover .cal-popover),
  .calendar-days :global(.cal-day.has-events:focus-within .cal-popover),
  .calendar-days :global(.cal-popover:hover) {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .calendar-days :global(.cal-popover-row + .cal-popover-row) {
    margin-top: 0.4rem;
    padding-top: 0.4rem;
    border-top: 1px solid var(--color-border);
  }

  .calendar-days :global(.cal-popover-title) {
    font-weight: 600;
    color: var(--color-primary-dark);
    line-height: 1.25;
    display: block;
  }

  .calendar-days :global(.cal-popover-title:hover) {
    text-decoration: underline;
  }

  .calendar-days :global(.cal-popover-meta) {
    font-size: 0.72rem;
    color: var(--color-text-light);
    margin-top: 0.15rem;
  }

  /* Hide the hover popover on touch/small screens — they get the click-to-detail flow instead. */
  @media (max-width: 900px), (hover: none) {
    .calendar-days :global(.cal-popover) {
      display: none;
    }
  }

  .calendar-detail {
    margin-top: var(--spacing-sm);
  }

  .calendar-detail :global(.cal-detail-card) {
    padding: var(--spacing-sm);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    margin-bottom: var(--spacing-xs);
    background: var(--color-background-alt);
  }

  .calendar-detail :global(.cal-detail-title) {
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--color-primary-dark);
    margin-bottom: 0.15rem;
  }

  .calendar-detail :global(.cal-detail-meta) {
    font-size: 0.8rem;
    color: var(--color-text-light);
  }

  .calendar-detail :global(.cal-detail-summary) {
    font-size: 0.8rem;
    margin-top: 0.35rem;
  }

  .calendar-detail :global(.cal-detail-link) {
    font-size: 0.8rem;
    margin-top: 0.25rem;
  }

  /* Mobile: calendar on top, list below */
  @media (max-width: 900px) {
    .events-layout {
      grid-template-columns: 1fr;
    }

    .events-calendar {
      order: -1;
    }

    .calendar-sticky {
      position: static;
    }
  }
</style>

<script define:vars={{ calendarEvents, typeColors, monthNames: months, calMinYear, calMinMonth, calMaxYear, calMaxMonth }}>
  const events = calendarEvents;
  const today = new Date();

  function esc(s) {
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }
  let currentYear = today.getFullYear();
  let currentMonth = today.getMonth();
  let selectedDay = null;

  const daysEl = document.getElementById('cal-days');
  const labelEl = document.getElementById('cal-label');
  const detailEl = document.getElementById('cal-detail');
  const prevBtn = document.getElementById('cal-prev');
  const nextBtn = document.getElementById('cal-next');

  function canGoPrev() {
    return currentYear > calMinYear || (currentYear === calMinYear && currentMonth > calMinMonth);
  }

  function canGoNext() {
    return currentYear < calMaxYear || (currentYear === calMaxYear && currentMonth < calMaxMonth);
  }

  prevBtn?.addEventListener('click', () => {
    if (!canGoPrev()) return;
    currentMonth--;
    if (currentMonth < 0) { currentMonth = 11; currentYear--; }
    selectedDay = null;
    renderMonth();
  });

  nextBtn?.addEventListener('click', () => {
    if (!canGoNext()) return;
    currentMonth++;
    if (currentMonth > 11) { currentMonth = 0; currentYear++; }
    selectedDay = null;
    renderMonth();
  });

  function eventsOnDay(year, month, day) {
    return events.filter(e => {
      // e.date is a plain "YYYY-MM-DD" — compare by components so no timezone
      // conversion can shift the event to an adjacent day.
      const [y, m, d] = e.date.split('-').map(Number);
      return y === year && (m - 1) === month && d === day;
    });
  }

  function renderMonth() {
    if (!daysEl || !labelEl || !detailEl) return;
    labelEl.textContent = monthNames[currentMonth] + ' ' + currentYear;

    // Update nav button states
    if (prevBtn) prevBtn.disabled = !canGoPrev();
    if (nextBtn) nextBtn.disabled = !canGoNext();

    const firstDay = new Date(currentYear, currentMonth, 1).getDay();
    const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();

    let html = '';

    for (let i = 0; i < firstDay; i++) {
      html += '<div class="cal-day empty"></div>';
    }

    for (let d = 1; d <= daysInMonth; d++) {
      const dayEvents = eventsOnDay(currentYear, currentMonth, d);
      const isToday = d === today.getDate() && currentMonth === today.getMonth() && currentYear === today.getFullYear();
      const isSelected = d === selectedDay;
      const classes = ['cal-day'];
      if (isToday) classes.push('today');
      if (dayEvents.length > 0) classes.push('has-events');
      if (isSelected) classes.push('selected');

      html += `<div class="${classes.join(' ')}" data-day="${d}">`;
      html += `<span class="cal-day-num">${d}</span>`;
      if (dayEvents.length > 0) {
        html += '<div class="cal-dots">';
        dayEvents.forEach(e => {
          const color = typeColors[e.type] || '#666';
          html += `<span class="cal-dot" style="background:${color};" title="${esc(e.title)}"></span>`;
        });
        html += '</div>';

        html += '<div class="cal-popover" role="tooltip">';
        dayEvents.forEach(e => {
          html += '<div class="cal-popover-row">';
          if (e.url) {
            html += `<a class="cal-popover-title" href="${esc(e.url)}">${esc(e.title)}</a>`;
          } else {
            html += `<span class="cal-popover-title">${esc(e.title)}</span>`;
          }
          html += `<div class="cal-popover-meta">${esc(e.time)} &middot; ${esc(e.location)}</div>`;
          html += '</div>';
        });
        html += '</div>';
      }
      html += '</div>';
    }

    daysEl.innerHTML = html;

    daysEl.querySelectorAll('.cal-day.has-events').forEach(cell => {
      cell.addEventListener('click', () => {
        const day = parseInt(cell.getAttribute('data-day'));
        selectedDay = day;
        renderMonth();
        showDayDetail(day);
      });
    });

    if (selectedDay) showDayDetail(selectedDay);
    else detailEl.innerHTML = '';
  }

  function showDayDetail(day) {
    if (!detailEl) return;
    const dayEvents = eventsOnDay(currentYear, currentMonth, day);
    if (dayEvents.length === 0) { detailEl.innerHTML = ''; return; }

    let html = '';
    dayEvents.forEach(e => {
      html += '<div class="cal-detail-card">';
      html += `<div class="cal-detail-title">${esc(e.title)}</div>`;
      html += `<div class="cal-detail-meta">${esc(e.time)} | ${esc(e.location)}</div>`;
      if (e.summary) html += `<div class="cal-detail-summary">${esc(e.summary)}</div>`;
      if (e.url) html += `<div class="cal-detail-link"><a href="${esc(e.url)}">Details &rarr;</a></div>`;
      html += '</div>';
    });
    detailEl.innerHTML = html;
  }

  // Render on load
  renderMonth();
</script>
