---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Bylaws" description="BWNA Bylaws - the governing rules of the Beaumont-Wilshire Neighborhood Association.">
  <section class="hero" style="padding: 2rem 0;">
    <div class="container">
      <h1>BWNA Bylaws</h1>
      <p>Governing rules of the association</p>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-width">
      <p>
        The BWNA Bylaws establish the rules and procedures that govern the Beaumont-Wilshire
        Neighborhood Association. They define membership, board structure, meeting procedures,
        and amendment processes.
      </p>
      <div class="card" style="background: var(--color-primary-light); margin: 1.5rem 0;">
        <h3>Key Provisions</h3>
        <ul style="margin-left: 1.5rem;">
          <li>Membership is free and open to all residents, property owners, businesses, and nonprofits within the boundary</li>
          <li>Board of directors elected by membership at the annual meeting</li>
          <li>General meetings held bimonthly; board meetings held on alternating months</li>
          <li>Amendments require notice to membership and a vote at a general meeting</li>
        </ul>
      </div>
      <p>
        For a full copy of the current bylaws, please contact
        <a href="mailto:president@bwnapdx.org">president@bwnapdx.org</a>.
      </p>
      <p style="margin-top: 2rem;">
        <a href={`${base}about`}>&larr; Back to About Us</a>
      </p>
    </div>
  </section>
</BaseLayout>
