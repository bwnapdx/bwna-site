---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Bylaws" description="BWNA Bylaws - the governing rules of the Beaumont-Wilshire Neighborhood Association.">
  <section class="hero">
    <div class="container">
      <h1>BWNA Bylaws</h1>
      <p>Adopted November 9, 2026</p>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-width">
      <p>
        The BWNA Bylaws establish the rules and procedures that govern the Beaumont-Wilshire
        Neighborhood Association. They define board structure, meeting procedures, and
        amendment processes.
      </p>
      <p class="proposed-callout">
        <strong>Newly revised.</strong> These bylaws were updated by vote at the November 9, 2026
        General Meeting. They replace the
        <a href={`${base}documents/bwna-bylaws-2024.pdf`}>bylaws adopted December 9, 2024 (PDF)</a>.
      </p>
      <div class="pdf-viewer">
        <object data={`${base}documents/bwna-bylaws.pdf`} type="application/pdf" width="100%" height="800px">
          <p>Your browser does not support embedded PDFs. <a href={`${base}documents/bwna-bylaws.pdf`}>Download the BWNA Bylaws (PDF)</a>.</p>
        </object>
      </div>
      <p class="pdf-download">
        <a href={`${base}documents/bwna-bylaws.pdf`} class="btn btn-primary" download>Download Bylaws (PDF)</a>
      </p>
      <p>
        <a href={`${base}about`}>&larr; Back to About Us</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .proposed-callout {
    background: var(--color-primary-light);
    border-left: 4px solid var(--color-primary);
    border-radius: 6px;
    padding: var(--spacing-md) var(--spacing-lg);
  }
</style>
