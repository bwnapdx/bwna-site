---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Bylaws" description="BWNA Bylaws - the governing rules of the Beaumont-Wilshire Neighborhood Association.">
  <section class="hero">
    <div class="container">
      <h1>BWNA Bylaws</h1>
      <p>Adopted December 9, 2024</p>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-width">
      <p>
        The BWNA Bylaws establish the rules and procedures that govern the Beaumont-Wilshire
        Neighborhood Association. They define membership, board structure, meeting procedures,
        and amendment processes.
      </p>
      <div class="pdf-viewer">
        <object data={`${base}documents/bwna-bylaws.pdf`} type="application/pdf" width="100%" height="800px">
          <p>Your browser does not support embedded PDFs. <a href={`${base}documents/bwna-bylaws.pdf`}>Download the BWNA Bylaws (PDF)</a>.</p>
        </object>
      </div>
      <p class="pdf-download">
        <a href={`${base}documents/bwna-bylaws.pdf`} class="btn btn-primary" download>Download Bylaws (PDF)</a>
      </p>
      <p>
        <a href={`${base}about`}>&larr; Back to About Us</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .pdf-viewer {
    margin: 1.5rem 0;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
  }

  .pdf-download {
    margin-bottom: 1.5rem;
  }
</style>
