---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

const opportunities = [
  {
    title: "Upcoming Events",
    icon: "🎉",
    description: "Help set up, assist guests, run activities, clean up, and support event organizers as needed.",
    commitment: "Varies by event",
    contact: "events@bwnapdx.org"
  },
  {
    title: "BWNA Newsletter",
    icon: "📰",
    description: "Gather news, write articles, design layout, and distribute updates to keep neighbors informed.",
    commitment: "Bimonthly, 2-5 hours",
    contact: "editor@bwnapdx.org"
  },
  {
    title: "Newsletter Delivery",
    icon: "🚶",
    description: "Deliver newsletters to homes on your block or nearby streets. Great exercise and a way to meet neighbors!",
    commitment: "6x per year, 1-2 hours each",
    contact: "editor@bwnapdx.org"
  },
  {
    title: "Beautification Projects",
    icon: "🌱",
    description: "Planting, cleaning, painting, landscaping, and maintaining public spaces to improve curb appeal.",
    commitment: "Seasonal, varies",
    contact: "president@bwnapdx.org"
  },
  {
    title: "Friends of Wilshire Park",
    icon: "🌳",
    description: "Join this volunteer group dedicated to keeping Wilshire Park vibrant and welcoming for all.",
    commitment: "Monthly meetups",
    link: "https://www.friendsofwilshirepark.org/"
  },
  {
    title: "Board Membership",
    icon: "🏛️",
    description: "Help guide the direction of BWNA by joining the board of directors. Elections held annually.",
    commitment: "2-year term, monthly meetings",
    contact: "president@bwnapdx.org"
  }
];
---

<BaseLayout title="Get Involved" description="Volunteer opportunities with the Beaumont-Wilshire Neighborhood Association. Find ways to contribute to your community.">

  <section class="hero">
    <div class="container">
      <h1>Get Involved</h1>
      <p>Your community needs you!</p>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-width">
      <p class="lead">
        While the Beaumont-Wilshire Neighborhood Association is officially guided by a volunteer
        board of directors, the strength of our community lies in the many residents who step
        up to provide valuable input, lend their time, and support neighborhood initiatives.
      </p>
      <p>
        From event planning to advocacy and cleanup efforts, our work is powered by neighbors
        who care deeply about making this a vibrant, welcoming place to live.
      </p>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <div class="section-header">
        <h2>Volunteer Opportunities</h2>
        <p>Find a way to contribute that fits your schedule and interests</p>
      </div>

      <div class="grid grid-2">
        {opportunities.map((opp) => (
          <div class="card">
            <h3 class="opp-title">
              <span class="opp-icon">{opp.icon}</span>
              {opp.title}
            </h3>
            <p>{opp.description}</p>
            <p class="text-sm text-muted">
              <strong>Time commitment:</strong> {opp.commitment}
            </p>
            {opp.contact ? (
              <a href={`mailto:${opp.contact}`} class="btn btn-secondary opp-btn">
                Contact to Volunteer
              </a>
            ) : opp.link ? (
              <a href={opp.link} target="_blank" rel="noopener" class="btn btn-secondary opp-btn">
                Learn More &rarr;
              </a>
            ) : null}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-width">
      <div class="card card--highlight meeting-card">
        <h3>Attend a BWNA Meeting</h3>
        <p>
          The easiest way to get involved is to attend one of our meetings! Listen, share
          concerns, vote on issues, meet neighbors, and stay updated on community plans.
        </p>
        <p>
          <strong>General Meetings:</strong> 2nd Monday of even months, 7 PM<br>
          <strong>Board Meetings:</strong> 2nd Monday of odd months, 7 PM
        </p>
        <a href={`${base}events`} class="btn btn-secondary">See Meeting Schedule</a>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-width">
      <div class="section-header">
        <h2>Express Volunteer Interest</h2>
        <p>
          Not sure where to start, or want us to know which opportunities appeal to
          you? Send us a note and we'll reach out as openings come up.
        </p>
      </div>
      <form action="https://formspree.io/p/3003290244603706655/f/volunteer" method="POST" class="volunteer-form" data-formspree="volunteer">
        <div class="form-row">
          <div class="form-group">
            <label for="vol-name">Name <span class="required">*</span></label>
            <input type="text" id="vol-name" name="name" required>
          </div>
          <div class="form-group">
            <label for="vol-email">Email <span class="required">*</span></label>
            <input type="email" id="vol-email" name="email" required>
          </div>
        </div>
        <div class="form-group">
          <label for="vol-phone">Phone</label>
          <input type="tel" id="vol-phone" name="phone">
        </div>
        <fieldset class="form-group">
          <legend>I'm interested in:</legend>
          <label class="checkbox"><input type="checkbox" name="interests" value="Upcoming Events"> Helping with upcoming events</label>
          <label class="checkbox"><input type="checkbox" name="interests" value="BWNA Newsletter"> Newsletter (writing, design, editing)</label>
          <label class="checkbox"><input type="checkbox" name="interests" value="Newsletter Delivery"> Newsletter delivery</label>
          <label class="checkbox"><input type="checkbox" name="interests" value="Board Membership"> Board membership</label>
          <label class="checkbox"><input type="checkbox" name="interests" value="Open to anything"> I'm open to anything — match me with what's needed</label>
        </fieldset>
        <div class="form-group">
          <label for="vol-message">Tell us more (optional)</label>
          <textarea id="vol-message" name="message" rows="5" placeholder="Skills, availability, or anything else we should know"></textarea>
        </div>
        <button type="submit" class="btn btn-secondary">Send</button>
        <p class="form-status" data-form-status hidden role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

</BaseLayout>

<style>
  .lead {
    font-size: 1.125rem;
  }

  .opp-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .opp-icon {
    font-size: 1.5rem;
  }

  .opp-btn {
    margin-top: var(--spacing-sm);
  }

  .meeting-card {
    text-align: center;
  }

  .card--featured {
    border: 2px solid var(--color-accent);
  }

  .volunteer-form {
    max-width: 600px;
    margin: var(--spacing-lg) auto 0;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-md);
  }

  .form-group {
    margin-bottom: var(--spacing-md);
    border: none;
    padding: 0;
  }

  .form-group label,
  .form-group legend {
    display: block;
    font-weight: 500;
    margin-bottom: var(--spacing-xs);
  }

  .required {
    color: #dc2626;
  }

  .form-group input[type="text"],
  .form-group input[type="email"],
  .form-group input[type="tel"],
  .form-group textarea {
    width: 100%;
    padding: var(--spacing-sm) 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-family: var(--font-family);
    font-size: 1rem;
    transition: border-color 0.2s;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(30, 92, 58, 0.1);
  }

  .form-group textarea {
    resize: vertical;
  }

  .checkbox {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 400;
    margin-bottom: var(--spacing-xs);
    cursor: pointer;
  }

  .checkbox input {
    margin: 0;
  }

  .form-status {
    margin-top: var(--spacing-md);
    padding: 0.75rem 1rem;
    border-radius: 6px;
    font-size: 0.95rem;
  }

  .form-status--sending {
    background: #f3f4f6;
    color: #374151;
  }

  .form-status--success {
    background: #ecfdf5;
    color: #065f46;
    border: 1px solid #a7f3d0;
  }

  .form-status--error {
    background: #fef2f2;
    color: #991b1b;
    border: 1px solid #fecaca;
  }

  @media (max-width: 500px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import "../scripts/form-submit";
</script>
