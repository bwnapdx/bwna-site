---
import BaseLayout from '../layouts/BaseLayout.astro';
import ObfuscatedEmail from '../components/ObfuscatedEmail.astro';
import PageHero from '../components/PageHero.astro';
import SignupBand from '../components/SignupBand.astro';

const base = import.meta.env.BASE_URL;

const opportunities = [
  {
    title: "Events",
    icon: "🎉",
    image: `${base}images/get-involved/card-events.jpg`,
    imageAlt: "Kids raising their hands on the grass at a Movie in the Park event",
    description: "Help with events \u2013 occasionally or regularly as your time allows.",
    commitment: "Varies by event",
    contact: "events@bwnapdx.org"
  },
  {
    title: "BWNA Newsletter",
    icon: "📰",
    image: `${base}images/get-involved/card-newsletter.jpg`,
    imageAlt: "The cover of the July-August 2026 BWNA newsletter",
    description: "Gather news, write articles, design layout, and distribute updates to keep neighbors informed.",
    commitment: "Bimonthly, 2-5 hours",
    contact: "editor@bwnapdx.org"
  },
  {
    title: "Newsletter Delivery",
    icon: "🚶",
    image: `${base}images/get-involved/card-delivery.jpg`,
    imageAlt: "A volunteer with the newsletter distribution boxes on Fremont Street",
    description: "Deliver newsletters to homes on your block or nearby streets. Great exercise and a way to meet neighbors!",
    commitment: "Bimonthly, 1 to 2 hours each issue",
    contact: "editor@bwnapdx.org"
  },
  {
    title: "Friends of Wilshire Park",
    icon: "🌳",
    image: `${base}images/get-involved/card-wilshire-park.jpg`,
    imageAlt: "A neighbor and her dog at the Wilshire Park dog fountain",
    description: "Join this volunteer group dedicated to keeping Wilshire Park vibrant and welcoming for all.",
    commitment: "Monthly meetups",
    link: "https://www.friendsofwilshirepark.org/"
  },
  {
    title: "Board Membership",
    icon: "🏛️",
    image: `${base}images/get-involved/card-board.jpg`,
    imageAlt: "The Wilshire Park sign in golden morning light",
    description: "Help guide the direction of BWNA by joining the board of directors. Elections are held annually.",
    commitment: "2-year term, monthly meetings, lead projects",
    contact: "president@bwnapdx.org"
  }
];
---

<BaseLayout title="Get Involved" description="Volunteer opportunities with the Beaumont-Wilshire Neighborhood Association. Find ways to contribute to your community.">

  <PageHero
    title="Get Involved"
    subtitle="Your community needs you!"
    image={`${base}images/hero/hero-stairs`}
    maxWidth={1500}
    position="center 18%"
  />

  <section class="page-section">
    <div class="container content-width">
      <p class="lead">
        While the Beaumont-Wilshire Neighborhood Association is officially guided by a volunteer
        board of directors, the strength of our association lies in the many residents who step
        up to provide valuable input, lend their time, and support community-led activities and
        projects.
      </p>
      <p>
        From event planning to advocacy and cleanup efforts, our work is powered by neighbors
        who care deeply about making this a vibrant, welcoming place to live.
      </p>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <div class="section-header">
        <h2>Volunteer Opportunities</h2>
        <p>Find a way to contribute that fits your schedule and interests</p>
      </div>

      <div class="grid grid-2">
        {opportunities.map((opp) => (
          <div class="card opp-card">
            <img class="opp-img" src={opp.image} alt={opp.imageAlt} loading="lazy" />
            <h3 class="opp-title">
              <span class="opp-icon">{opp.icon}</span>
              {opp.title}
            </h3>
            <p>{opp.description}</p>
            <p class="text-sm text-muted">
              <strong>Time commitment:</strong> {opp.commitment}
            </p>
            {opp.contact ? (
              <ObfuscatedEmail email={opp.contact} label="Contact to Volunteer" class="btn btn-secondary opp-btn" />
            ) : opp.link ? (
              <a
                href={opp.link}
                class="btn btn-secondary opp-btn"
                {...(opp.link.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
              >
                {opp.linkLabel || 'Learn More →'}
              </a>
            ) : null}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-width">
      <div class="card card--highlight meeting-card">
        <h3>Attend a BWNA Meeting</h3>
        <p>
          The easiest way to get involved is to attend one of our meetings! Listen, share
          concerns, vote on issues, meet neighbors, and stay updated on community happenings.
        </p>
        <p>
          <strong>General Meetings:</strong> 2nd Monday of even months, 7 PM<br>
          <strong>Board Meetings:</strong> 2nd Monday of odd months, 7 PM
        </p>
        <a href={`${base}events`} class="btn btn-secondary">See Meeting Schedule</a>
      </div>
    </div>
  </section>

  <SignupBand />

</BaseLayout>

<style>
  .lead {
    font-size: 1.125rem;
  }

  /* Photo bleeds to the card edges above the title */
  .opp-card {
    padding-top: 0;
    overflow: hidden;
  }

  .opp-img {
    width: calc(100% + 2 * var(--spacing-lg));
    margin: 0 calc(-1 * var(--spacing-lg)) var(--spacing-md);
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .opp-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .opp-icon {
    font-size: 1.5rem;
  }

  .opp-btn {
    margin-top: var(--spacing-sm);
  }

  .meeting-card {
    text-align: center;
  }

  .card--featured {
    border: 2px solid var(--color-accent);
  }

</style>
