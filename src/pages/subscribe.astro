---
import BaseLayout from '../layouts/BaseLayout.astro';
import SignupBand from '../components/SignupBand.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Subscribe" description="Subscribe to BWNA email updates for neighborhood news, meetings, and events.">
  <section class="hero">
    <div class="container">
      <h1>Be in the Know!</h1>
      <p>Stay informed about neighborhood news and events</p>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-width">
      <p>
        Subscribe to our monthly emailed Community Update and stay up to date on BWNA meetings,
        community events, volunteer opportunities, and neighborhood announcements.
      </p>
    </div>
  </section>

  <SignupBand heading={null} intro={null} />

  <section class="page-section">
    <div class="container content-width">
      <div class="card card--highlight">
        <h3>Printed Newsletter</h3>
        <p>
          BWNA distributes a free bimonthly printed newsletter to over 2,700 neighborhood
          households and businesses. <a href={`${base}newsletters`}>Browse newsletter articles</a>
          or download past issues as PDFs.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
