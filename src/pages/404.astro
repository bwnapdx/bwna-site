---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist.">
  <section class="hero">
    <div class="container">
      <h1>Page Not Found</h1>
      <p>Sorry, we couldn't find what you were looking for.</p>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-width section-header">
      <p>The page may have been moved or no longer exists. Here are some helpful links:</p>
      <ul class="link-list">
        <li><a href={base}>Home</a></li>
        <li><a href={`${base}events`}>Upcoming Events</a></li>
        <li><a href={`${base}newsletters`}>Newsletter</a></li>
        <li><a href={`${base}resources`}>Community Resources</a></li>
        <li><a href={`${base}contact`}>Contact Us</a></li>
        <li><a href={`${base}search`}>Search the Site</a></li>
      </ul>
      <a href={base} class="btn btn-secondary">Return to Home</a>
    </div>
  </section>
</BaseLayout>
