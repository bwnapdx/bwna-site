---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import SignupBand from '../components/SignupBand.astro';
import StaleEventFilter from '../components/StaleEventFilter.astro';
import { expandEvents, toLocalDate } from '../data/expandEvents';

const base = import.meta.env.BASE_URL;

const heroSlides = [
  { src: `${base}images/hero/hero-movie-kids`, alt: 'Kids dancing on the grass at Movie in the Park' },
  { src: `${base}images/hero/hero-movie-crowd`, alt: 'Neighbors gathered on blankets and chairs for Movie in Wilshire Park', position: 'center 60%' },
  { src: `${base}images/hero/hero-dog-club`, alt: 'The neighborhood dog-walking group posing with their dogs in Wilshire Park' },
  { src: `${base}images/hero/hero-cleanup`, alt: 'Volunteers in safety vests at a Fremont Street clean-up' },
  // JF's widened re-crop. It survives the default focal point at ordinary
  // desktop sizes, but the hero's height caps at 560px while its width keeps
  // growing, so past ~2000px the crop still reaches the faces — hence 15%.
  // Source is 1600px wide, so there is no 2200w variant.
  { src: `${base}images/hero/hero-planting`, alt: 'Volunteers with buckets and shovels at a Wilshire Park planting', position: 'center 15%', maxWidth: 1600 },
];

const allEvents = await getCollection('events');

// The page is static, so "upcoming" is frozen at build time. We render a buffer
// of spares past the three on show; StaleEventFilter drops whatever has passed
// by the time someone actually loads the page and slides the spares up to fill
// in. That keeps the list honest between deploys without a scheduled rebuild.
const VISIBLE_EVENTS = 3;
const EVENT_BUFFER = 12;
const upcomingEvents = expandEvents(allEvents).slice(0, EVENT_BUFFER);

const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

/** Local calendar day as YYYY-MM-DD — toISOString() would shift it west of Greenwich. */
const ymd = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
---

<BaseLayout searchable={false} title="Home">
  <!-- Hero Carousel -->
  <HeroCarousel slides={heroSlides} />

  <!-- Intro -->
  <section class="page-section">
    <div class="container content-width intro">
      <h2>You live in the neighborhood &mdash; now join the community!</h2>
      <p>
        If you're looking to be more engaged in our truly special neighborhood, you've come
        to the right place. We invite you to explore events, community resources, and
        volunteer opportunities, and find answers to common questions about BWNA.
      </p>
    </div>
  </section>

  <!-- Newsletter Signup -->
  <SignupBand />

  <!-- Upcoming Events -->
  <section class="page-section">
    <div class="container">
      <div class="section-header">
        <h2>Upcoming Events</h2>
        <p>Join your neighbors at an upcoming event</p>
      </div>

      <div class="content-width centered" data-events-list>
        {upcomingEvents.map((ev, i) => (
          <div
            class="event-item"
            data-event
            hidden={i >= VISIBLE_EVENTS}
            data-start={ymd(ev.date)}
            data-end={!ev.entry.data.recurring && ev.entry.data.endDate
              ? ymd(toLocalDate(ev.entry.data.endDate))
              : undefined}
          >
            <div class="event-date">
              <div class="month">{months[ev.date.getMonth()]}</div>
              <div class="day">{ev.date.getDate()}</div>
            </div>
            <div class="event-details">
              <h3>
                {!ev.entry.data.recurring && (ev.entry.body || '').trim().length > 10 ? (
                  <a href={`${base}events/${ev.entry.id.replace(/\.md$/, '')}`}>{ev.entry.data.title}</a>
                ) : (
                  ev.entry.data.title
                )}
              </h3>
              <div class="event-meta">
                {ev.entry.data.time} • {ev.entry.data.location}
              </div>
              <p>{ev.entry.data.summary || ''}</p>
            </div>
          </div>
        ))}
        <p class="event-empty" data-events-empty hidden>
          Nothing on the calendar right now &mdash; see the events page for the latest schedule.
        </p>
      </div>

      <StaleEventFilter limit={VISIBLE_EVENTS} />


      <div class="section-footer">
        <a href={`${base}events`} class="btn btn-secondary">View All Events</a>
      </div>
    </div>
  </section>

  <!-- Quick Links Section -->
  <section class="page-section">
    <div class="container">
      <div class="grid grid-3">
        <div class="card">
          <h3>Latest Newsletter</h3>
          <p>Read the latest issue for neighborhood news, events, and feature stories.</p>
          <a href={`${base}newsletters`}>Read Newsletter &rarr;</a>
        </div>

        <div class="card">
          <h3>Volunteer With Us</h3>
          <p>From event planning to newsletter delivery, there are many ways to contribute to our community.</p>
          <a href={`${base}get-involved`}>Get Involved &rarr;</a>
        </div>

        <div class="card">
          <h3>Community Resources</h3>
          <p>Emergency phone numbers, links to government services, and other helpful contact information.</p>
          <a href={`${base}resources`}>View Resources &rarr;</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .centered {
    margin: 0 auto;
  }

  .intro {
    text-align: center;
  }

</style>
