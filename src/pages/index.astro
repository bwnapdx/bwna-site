---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { expandEvents } from '../data/expandEvents';

const base = import.meta.env.BASE_URL;

const allEvents = await getCollection('events');
const upcomingEvents = expandEvents(allEvents).slice(0, 3);

const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
---

<BaseLayout title="Home">
  <!-- Hero Section -->
  <section class="hero hero--tall hero--bg" style={`background-image: url('${base}images/hero-neighborhood.jpg');`}>
    <div class="container">
      <h1>Beaumont-Wilshire Neighborhood Association</h1>
      <p>
        Nestled among the luscious trees of Northeast Portland, our community is known
        for its mix of urban and serene lifestyles. We're a group of proud residents
        who strive to maintain a high standard of living through events and local services.
      </p>
      <div class="hero-buttons">
        <a href={`${base}about`} class="btn btn-primary">Learn About Us</a>
        <a href={`${base}get-involved`} class="btn btn--outline">Get Involved</a>
      </div>
    </div>
  </section>

  <!-- About Preview -->
  <section class="page-section">
    <div class="container">
      <div class="grid grid-2 grid--aligned">
        <div>
          <h2>About Our Neighborhood</h2>
          <p>
            The Beaumont-Wilshire Neighborhood Association (BWNA) is one of 95 officially
            recognized neighborhood associations in Portland's historic tradition of local
            volunteer activism and involvement.
          </p>
          <p>
            Our boundary includes much of the Fremont and NE 42nd Avenue business districts,
            Beaumont Middle School, and beautiful Wilshire Park.
          </p>
          <p>
            <strong>Membership is free</strong> and open to all residents, property owners,
            businesses, and nonprofits in the neighborhood.
          </p>
          <a href={`${base}about`} class="btn btn-secondary">Meet Our Board</a>
        </div>
        <div>
          <img src={`${base}images/bwna-map.jpg`} alt="Beaumont-Wilshire neighborhood boundary map" class="map-img">
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter Signup -->
  <section class="page-section cta-section">
    <div class="container">
      <h2>Stay in the Know!</h2>
      <p>
        Subscribe to receive monthly email updates about BWNA meetings, activities,
        and neighborhood announcements.
      </p>
      <a href={`${base}subscribe`} class="btn btn-primary">Subscribe to Updates</a>
    </div>
  </section>

  <!-- Upcoming Events -->
  <section class="page-section">
    <div class="container">
      <div class="section-header">
        <h2>Upcoming Events</h2>
        <p>Join us at our next community gathering</p>
      </div>

      <div class="content-width centered">
        {upcomingEvents.map((ev) => (
          <div class="event-item">
            <div class="event-date">
              <div class="month">{months[ev.date.getMonth()]}</div>
              <div class="day">{ev.date.getDate()}</div>
            </div>
            <div class="event-details">
              <h3>
                {!ev.entry.data.recurring && (ev.entry.body || '').trim().length > 10 ? (
                  <a href={`${base}events/${ev.entry.id.replace(/\.md$/, '')}`}>{ev.entry.data.title}</a>
                ) : (
                  ev.entry.data.title
                )}
              </h3>
              <div class="event-meta">
                {ev.entry.data.time} • {ev.entry.data.location}
              </div>
              <p>{ev.entry.data.summary || ''}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="section-footer">
        <a href={`${base}events`} class="btn btn-secondary">View All Events</a>
      </div>
    </div>
  </section>

  <!-- Quick Links Section -->
  <section class="page-section">
    <div class="container">
      <div class="section-header">
        <h2>How Can We Help?</h2>
      </div>

      <div class="grid grid-3">
        <div class="card">
          <h3>Latest Newsletter</h3>
          <p>Read the latest issue for neighborhood news, events, and community updates.</p>
          <a href={`${base}newsletters`}>Read Newsletter &rarr;</a>
        </div>

        <div class="card">
          <h3>Volunteer With Us</h3>
          <p>From event planning to newsletter delivery, there are many ways to contribute to our community.</p>
          <a href={`${base}get-involved`}>Find Opportunities &rarr;</a>
        </div>

        <div class="card">
          <h3>Community Resources</h3>
          <p>Emergency contacts, city services, and helpful links for Beaumont-Wilshire residents.</p>
          <a href={`${base}resources`}>View Resources &rarr;</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero--bg {
    background: linear-gradient(rgba(30,92,58,0.8), rgba(92,138,62,0.85)) center/cover no-repeat;
    background-size: cover;
    background-position: center;
  }

  .hero-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .centered {
    margin: 0 auto;
  }

  .grid--aligned {
    align-items: center;
  }

  .map-img {
    width: 100%;
    border-radius: 8px;
    border: 1px solid var(--color-border);
  }
</style>
