---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import SignupBand from '../components/SignupBand.astro';
import { expandEvents } from '../data/expandEvents';

const base = import.meta.env.BASE_URL;

const heroSlides = [
  { src: `${base}images/hero/hero-movie-kids`, alt: 'Kids dancing on the grass at Movie in the Park' },
  { src: `${base}images/hero/hero-movie-crowd`, alt: 'Neighbors gathered on blankets and chairs for Movie in Wilshire Park', position: 'center 60%' },
  { src: `${base}images/hero/hero-dog-club`, alt: 'The neighborhood dog-walking group posing with their dogs in Wilshire Park' },
  { src: `${base}images/hero/hero-cleanup`, alt: 'Volunteers in safety vests at a Fremont Street clean-up' },
  { src: `${base}images/hero/hero-planting`, alt: 'Volunteers with buckets and shovels at a Wilshire Park planting' },
];

const allEvents = await getCollection('events');
const upcomingEvents = expandEvents(allEvents).slice(0, 3);

const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
---

<BaseLayout searchable={false} title="Home">
  <!-- Hero Carousel -->
  <HeroCarousel slides={heroSlides} />

  <!-- Intro -->
  <section class="page-section">
    <div class="container content-width intro">
      <h2>You live in the neighborhood &mdash; now join the community!</h2>
      <p>
        If you're looking to be more engaged in our truly special neighborhood, you've come
        to the right place. We invite you to explore events, community resources, and
        volunteer opportunities, and find answers to common questions about BWNA.
      </p>
    </div>
  </section>

  <!-- Newsletter Signup -->
  <SignupBand />

  <!-- Upcoming Events -->
  <section class="page-section">
    <div class="container">
      <div class="section-header">
        <h2>Upcoming Events</h2>
        <p>Join us at our next community gathering</p>
      </div>

      <div class="content-width centered">
        {upcomingEvents.map((ev) => (
          <div class="event-item">
            <div class="event-date">
              <div class="month">{months[ev.date.getMonth()]}</div>
              <div class="day">{ev.date.getDate()}</div>
            </div>
            <div class="event-details">
              <h3>
                {!ev.entry.data.recurring && (ev.entry.body || '').trim().length > 10 ? (
                  <a href={`${base}events/${ev.entry.id.replace(/\.md$/, '')}`}>{ev.entry.data.title}</a>
                ) : (
                  ev.entry.data.title
                )}
              </h3>
              <div class="event-meta">
                {ev.entry.data.time} • {ev.entry.data.location}
              </div>
              <p>{ev.entry.data.summary || ''}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="section-footer">
        <a href={`${base}events`} class="btn btn-secondary">View All Events</a>
      </div>
    </div>
  </section>

  <!-- Quick Links Section -->
  <section class="page-section">
    <div class="container">
      <div class="grid grid-3">
        <div class="card">
          <h3>Latest Newsletter</h3>
          <p>Read the latest issue for neighborhood news, events, and community updates.</p>
          <a href={`${base}newsletters`}>Read Newsletter &rarr;</a>
        </div>

        <div class="card">
          <h3>Volunteer With Us</h3>
          <p>From event planning to newsletter delivery, there are many ways to contribute to our community.</p>
          <a href={`${base}get-involved`}>Find Opportunities &rarr;</a>
        </div>

        <div class="card">
          <h3>Community Resources</h3>
          <p>Emergency contacts, city services, and helpful links for Beaumont-Wilshire residents.</p>
          <a href={`${base}resources`}>View Resources &rarr;</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .centered {
    margin: 0 auto;
  }

  .intro {
    text-align: center;
  }

</style>
