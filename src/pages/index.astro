---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import { expandEvents } from '../data/expandEvents';

const base = import.meta.env.BASE_URL;

const heroSlides = [
  { src: `${base}images/hero/hero-movie-kids`, alt: 'Kids dancing on the grass at Movie in the Park' },
  { src: `${base}images/hero/hero-movie-crowd`, alt: 'Neighbors gathered on blankets and chairs for Movie in Wilshire Park', position: 'center 60%' },
  { src: `${base}images/hero/hero-dog-club`, alt: 'The neighborhood dog-walking group posing with their dogs in Wilshire Park' },
  { src: `${base}images/hero/hero-cleanup`, alt: 'Volunteers in safety vests at a Fremont Street clean-up' },
  { src: `${base}images/hero/hero-planting`, alt: 'Volunteers with buckets and shovels at a Wilshire Park planting' },
];

const allEvents = await getCollection('events');
const upcomingEvents = expandEvents(allEvents).slice(0, 3);

const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
---

<BaseLayout title="Home">
  <!-- Hero Carousel -->
  <HeroCarousel slides={heroSlides} />

  <!-- About Preview -->
  <section class="page-section">
    <div class="container">
      <div class="about-grid">
        <div class="about-map">
          <img src={`${base}images/bwna-map.png`} alt="Beaumont-Wilshire neighborhood boundary map" class="map-img">
        </div>
        <div class="about-text">
          <p>
            The Beaumont-Wilshire Neighborhood Association (BWNA) is one of 95 officially
            recognized neighborhood associations in Portland's historic tradition of local
            volunteer activism and involvement.
          </p>
          <p>
            Located in northeast Portland, our boundary includes much of the Fremont and
            NE 42nd Avenue business districts, Beaumont Middle School, and beautiful
            Wilshire Park.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter Signup -->
  <section class="page-section cta-section signup-band">
    <div class="container">
      <h2>Stay in the Know!</h2>
      <p>
        Subscribe to receive monthly email updates about BWNA meetings, activities,
        and neighborhood news.
      </p>
      <form
        action="https://bwnapdx.us21.list-manage.com/subscribe/post?u=203722a9c2f8af9e6db5b3d86&amp;id=bc0c6760de&amp;f_id=00aad5e6f0"
        method="post"
        target="_blank"
        class="signup-form"
      >
        <p class="signup-required">* indicates required field</p>
        <div class="signup-fields">
          <div class="signup-field">
            <label for="home-mce-EMAIL">Email Address *</label>
            <input type="email" name="EMAIL" id="home-mce-EMAIL" required>
          </div>
          <div class="signup-field">
            <label for="home-mce-FNAME">First Name</label>
            <input type="text" name="FNAME" id="home-mce-FNAME">
          </div>
          <div class="signup-field">
            <label for="home-mce-LNAME">Last Name</label>
            <input type="text" name="LNAME" id="home-mce-LNAME">
          </div>
        </div>
        <div class="signup-honeypot" aria-hidden="true">
          <input type="text" name="b_203722a9c2f8af9e6db5b3d86_bc0c6760de" tabindex="-1" value="">
        </div>
        <button type="submit" class="btn signup-submit">Subscribe</button>
        <p class="signup-powered">Powered by MailChimp</p>
      </form>
    </div>
  </section>

  <!-- Upcoming Events -->
  <section class="page-section">
    <div class="container">
      <div class="section-header">
        <h2>Upcoming Events</h2>
        <p>Join us at our next community gathering</p>
      </div>

      <div class="content-width centered">
        {upcomingEvents.map((ev) => (
          <div class="event-item">
            <div class="event-date">
              <div class="month">{months[ev.date.getMonth()]}</div>
              <div class="day">{ev.date.getDate()}</div>
            </div>
            <div class="event-details">
              <h3>
                {!ev.entry.data.recurring && (ev.entry.body || '').trim().length > 10 ? (
                  <a href={`${base}events/${ev.entry.id.replace(/\.md$/, '')}`}>{ev.entry.data.title}</a>
                ) : (
                  ev.entry.data.title
                )}
              </h3>
              <div class="event-meta">
                {ev.entry.data.time} • {ev.entry.data.location}
              </div>
              <p>{ev.entry.data.summary || ''}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="section-footer">
        <a href={`${base}events`} class="btn btn-secondary">View All Events</a>
      </div>
    </div>
  </section>

  <!-- Quick Links Section -->
  <section class="page-section">
    <div class="container">
      <div class="section-header">
        <h2>How Can We Help?</h2>
      </div>

      <div class="grid grid-3">
        <div class="card">
          <h3>Latest Newsletter</h3>
          <p>Read the latest issue for neighborhood news, events, and community updates.</p>
          <a href={`${base}newsletters`}>Read Newsletter &rarr;</a>
        </div>

        <div class="card">
          <h3>Volunteer With Us</h3>
          <p>From event planning to newsletter delivery, there are many ways to contribute to our community.</p>
          <a href={`${base}get-involved`}>Find Opportunities &rarr;</a>
        </div>

        <div class="card">
          <h3>Community Resources</h3>
          <p>Emergency contacts, city services, and helpful links for Beaumont-Wilshire residents.</p>
          <a href={`${base}resources`}>View Resources &rarr;</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .centered {
    margin: 0 auto;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: var(--spacing-2xl);
    align-items: start;
    max-width: 960px;
    margin: 0 auto;
  }

  .map-img {
    width: 100%;
    border-radius: 4px;
    border: 1px solid var(--color-border);
  }

  @media (max-width: 640px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
    }

    /* Read the text first on mobile; map follows smaller */
    .about-map {
      order: 2;
    }

    .about-grid .map-img {
      max-width: 260px;
      margin: 0 auto;
      display: block;
    }
  }

  /* Inline MailChimp signup band */
  .signup-form {
    max-width: 820px;
    margin: 0 auto;
  }

  .signup-required {
    font-size: 0.8rem;
    opacity: 0.9;
    margin-bottom: var(--spacing-sm);
  }

  .signup-fields {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-lg);
    text-align: left;
    margin-bottom: var(--spacing-lg);
  }

  @media (max-width: 640px) {
    .signup-fields {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }
  }

  .signup-field label {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 0.3rem;
  }

  .signup-field input {
    width: 100%;
    padding: 0.5rem 0.6rem;
    border: none;
    border-radius: 3px;
    font-size: 1rem;
    font-family: var(--font-family);
  }

  .signup-honeypot {
    position: absolute;
    left: -5000px;
  }

  .signup-submit {
    background: var(--color-accent);
    color: var(--color-primary-dark);
    font-size: 1.05rem;
  }

  .signup-submit:hover {
    background: white;
  }

  .signup-powered {
    font-size: 0.75rem;
    opacity: 0.8;
    margin-top: var(--spacing-md);
    margin-bottom: 0;
  }
</style>
