---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categoryLabels } from '../data/categoryLabels';

const base = import.meta.env.BASE_URL;

// Curated chips drawn from the newsletter taxonomy — skip catch-alls
// (community-news, other) and meta categories (presidents-message,
// announcements, opinion) that aren't useful as browse destinations.
const chipCategories = [
  'land-use',
  'parks',
  'environment',
  'safety',
  'schools',
  'business',
  'events',
  'volunteer',
  'history',
] as const;
---

<BaseLayout title="Search" description="Search BWNA newsletter articles, events, and site content." noindex>
  <section class="hero">
    <div class="container">
      <h1>Search</h1>
      <p>Find articles, events, and resources across the site</p>
    </div>
  </section>

  <section class="page-section" data-pagefind-ignore>
    <div class="container content-width">
      <div id="search" class="search-container"></div>
      <div class="search-suggestions">
        <p>Or browse the article archive by topic:</p>
        <div class="suggestion-chips">
          {chipCategories.map(cat => (
            <a class="suggestion-chip" href={`${base}articles?category=${cat}`}>{categoryLabels[cat]} &rarr;</a>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* Pagefind theme variables — these are the supported API for customization */
  :root {
    --pagefind-ui-primary: #006092;
    --pagefind-ui-text: #333333;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: #d0d8de;
    --pagefind-ui-tag: #e6f1f8;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-font: inherit;
    --pagefind-ui-scale: 1;
  }

  /*
   * Pagefind UI overrides — using #search ID selector to beat
   * Pagefind's doubled Svelte scoped classes (e.g. .class.svelte-xxx)
   * without needing !important.
   */

  /* Form and input */
  #search .pagefind-ui__form {
    width: 100%;
  }

  #search .pagefind-ui__search-input {
    width: 100%;
    font-size: 1.125rem;
    padding: 0.875rem 1rem 0.875rem 3rem;
    border: 2px solid var(--pagefind-ui-border);
    border-radius: 8px;
    transition: border-color 0.2s;
    box-sizing: border-box;
  }

  #search .pagefind-ui__search-input:focus {
    border-color: var(--pagefind-ui-primary);
    outline: none;
    box-shadow: 0 0 0 3px rgba(0, 96, 146, 0.1);
  }

  #search .pagefind-ui__search-clear {
    display: none;
  }

  #search .pagefind-ui__drawer {
    width: 100%;
  }

  /* Results */
  #search .pagefind-ui__result {
    padding: 1.25rem 0;
    border-top: 1px solid #e8ede8;
  }

  #search .pagefind-ui__result-title .pagefind-ui__result-link {
    color: var(--pagefind-ui-primary);
    font-weight: 600;
  }

  #search .pagefind-ui__result-title .pagefind-ui__result-link:hover {
    text-decoration: underline;
  }

  #search .pagefind-ui__result-excerpt {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #555;
  }

  #search .pagefind-ui__result-excerpt mark {
    background: #eef3c8;
    color: inherit;
    padding: 0.1rem 0.2rem;
    border-radius: 2px;
  }

  #search .pagefind-ui__message {
    font-size: 0.95rem;
    padding: 1rem 0;
    color: #666;
  }

  /* Load more button */
  #search .pagefind-ui__button {
    background: var(--pagefind-ui-primary);
    color: white;
    border: none;
    border-radius: 6px;
    height: auto;
    padding: 0.75rem 1.5rem;
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
  }

  #search .pagefind-ui__button:hover {
    background: #004a70;
    color: white;
    border: none;
  }

  /* Hide filter panel for now */
  #search .pagefind-ui__filter-panel {
    display: none;
  }

  /* Metadata rows (Author, raw Date) — the date already shows in the
     title, and the static-page sentinel date should never be visible */
  #search .pagefind-ui__result-tags {
    display: none;
  }

  /* Sub-results */
  #search .pagefind-ui__result-nested .pagefind-ui__result-link {
    font-size: 0.9em;
  }
</style>

<style>
  .search-suggestions {
    margin-top: 1.5rem;
    text-align: center;
  }

  .search-suggestions p {
    font-size: 0.875rem;
    color: var(--color-text-light);
    margin-bottom: 0.75rem;
  }

  .suggestion-chips {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .suggestion-chip {
    display: inline-block;
    background: var(--color-primary-light);
    color: var(--color-primary);
    border: 1px solid transparent;
    padding: 0.35rem 0.85rem;
    border-radius: 20px;
    font-size: 0.85rem;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s;
  }

  .suggestion-chip:hover {
    background: white;
    border-color: var(--color-primary);
    color: var(--color-primary);
    text-decoration: none;
  }

  /* Hide suggestions once user has searched */
  .search-suggestions.hidden {
    display: none;
  }
</style>

<script>
  import { PagefindUI } from '@pagefind/default-ui';

  const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

  const pf = new PagefindUI({
    element: '#search',
    showSubResults: false,
    showImages: false,
    autofocus: true,
    bundlePath: import.meta.env.BASE_URL + 'pagefind/',
    ranking: {
      termSimilarity: 5.0,
    },
    // Newest first. Static pages carry a far-future sort date (see
    // BaseLayout) so current info outranks the article archive.
    sort: { date: 'desc' },
    // Dated content shows "Title · Mon YYYY"; the 9999 sentinel on
    // static pages is a placeholder, not a real date, so it's hidden.
    processResult: (result: any) => {
      const d = result?.meta?.date;
      if (d && d < '9000') {
        const [y, m] = d.split('-');
        result.meta.title = `${result.meta.title} · ${MONTHS[Number(m) - 1]} ${y}`;
      }
      return result;
    },
  });

  // Hide suggestions when user types, and hide zero-count filter categories
  const observer = new MutationObserver(() => {
    const input = document.querySelector('.pagefind-ui__search-input') as HTMLInputElement;
    if (input?.value) {
      document.querySelector('.search-suggestions')?.classList.add('hidden');
    } else {
      document.querySelector('.search-suggestions')?.classList.remove('hidden');
    }

  });

  const searchEl = document.getElementById('search');
  if (searchEl) {
    observer.observe(searchEl, { childList: true, subtree: true });
  }
</script>
