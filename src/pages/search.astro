---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search" description="Search BWNA newsletter articles, events, and site content.">
  <section class="hero">
    <div class="container">
      <h1>Search</h1>
      <p>Find articles, events, and resources across the site</p>
    </div>
  </section>

  <section class="page-section" data-pagefind-ignore>
    <div class="container content-width">
      <div id="search" class="search-container"></div>
      <div class="search-suggestions">
        <p>Try searching for:</p>
        <div class="suggestion-chips">
          <button class="suggestion-chip" data-query="volunteer">volunteer</button>
          <button class="suggestion-chip" data-query="Wilshire Park">Wilshire Park</button>
          <button class="suggestion-chip" data-query="recycling">recycling</button>
          <button class="suggestion-chip" data-query="Fremont">Fremont</button>
          <button class="suggestion-chip" data-query="meeting">meeting</button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* Pagefind theme variables — these are the supported API for customization */
  :root {
    --pagefind-ui-primary: #1e5c3a;
    --pagefind-ui-text: #333333;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: #d0d7d0;
    --pagefind-ui-tag: #e8f5e9;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-font: inherit;
    --pagefind-ui-scale: 1;
  }

  /*
   * Pagefind UI overrides — using #search ID selector to beat
   * Pagefind's doubled Svelte scoped classes (e.g. .class.svelte-xxx)
   * without needing !important.
   */

  /* Form and input */
  #search .pagefind-ui__form {
    width: 100%;
  }

  #search .pagefind-ui__search-input {
    width: 100%;
    font-size: 1.125rem;
    padding: 0.875rem 1rem 0.875rem 3rem;
    border: 2px solid var(--pagefind-ui-border);
    border-radius: 8px;
    transition: border-color 0.2s;
    box-sizing: border-box;
  }

  #search .pagefind-ui__search-input:focus {
    border-color: var(--pagefind-ui-primary);
    outline: none;
    box-shadow: 0 0 0 3px rgba(30, 92, 58, 0.1);
  }

  #search .pagefind-ui__search-clear {
    display: none;
  }

  #search .pagefind-ui__drawer {
    width: 100%;
  }

  /* Results */
  #search .pagefind-ui__result {
    padding: 1.25rem 0;
    border-top: 1px solid #e8ede8;
  }

  #search .pagefind-ui__result-title .pagefind-ui__result-link {
    color: var(--pagefind-ui-primary);
    font-weight: 600;
  }

  #search .pagefind-ui__result-title .pagefind-ui__result-link:hover {
    text-decoration: underline;
  }

  #search .pagefind-ui__result-excerpt {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #555;
  }

  #search .pagefind-ui__result-excerpt mark {
    background: #d4edda;
    color: inherit;
    padding: 0.1rem 0.2rem;
    border-radius: 2px;
  }

  #search .pagefind-ui__message {
    font-size: 0.95rem;
    padding: 1rem 0;
    color: #666;
  }

  /* Load more button */
  #search .pagefind-ui__button {
    background: var(--pagefind-ui-primary);
    color: white;
    border: none;
    border-radius: 6px;
    height: auto;
    padding: 0.75rem 1.5rem;
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
  }

  #search .pagefind-ui__button:hover {
    background: #164a2e;
    color: white;
    border: none;
  }

  /* Hide filter panel for now */
  #search .pagefind-ui__filter-panel {
    display: none;
  }

  /* Sub-results */
  #search .pagefind-ui__result-nested .pagefind-ui__result-link {
    font-size: 0.9em;
  }
</style>

<style>
  .search-suggestions {
    margin-top: 1.5rem;
    text-align: center;
  }

  .search-suggestions p {
    font-size: 0.875rem;
    color: var(--color-text-light);
    margin-bottom: 0.75rem;
  }

  .suggestion-chips {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .suggestion-chip {
    background: var(--color-primary-light);
    color: var(--color-primary);
    border: 1px solid transparent;
    padding: 0.35rem 0.85rem;
    border-radius: 20px;
    font-size: 0.85rem;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
  }

  .suggestion-chip:hover {
    background: white;
    border-color: var(--color-primary);
  }

  /* Hide suggestions once user has searched */
  .search-suggestions.hidden {
    display: none;
  }
</style>

<script>
  import { PagefindUI } from '@pagefind/default-ui';

  const pf = new PagefindUI({
    element: '#search',
    showSubResults: true,
    showImages: false,
    autofocus: true,
    bundlePath: import.meta.env.BASE_URL + 'pagefind/',
    ranking: {
      termSimilarity: 5.0,
    },
  });

  // Suggestion chips trigger a search
  document.querySelectorAll('.suggestion-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const query = chip.getAttribute('data-query');
      const input = document.querySelector('.pagefind-ui__search-input') as HTMLInputElement;
      if (input) {
        input.value = query!;
        input.dispatchEvent(new Event('input', { bubbles: true }));
        document.querySelector('.search-suggestions')?.classList.add('hidden');
      }
    });
  });

  // Hide suggestions when user types, and hide zero-count filter categories
  const observer = new MutationObserver(() => {
    const input = document.querySelector('.pagefind-ui__search-input') as HTMLInputElement;
    if (input?.value) {
      document.querySelector('.search-suggestions')?.classList.add('hidden');
    } else {
      document.querySelector('.search-suggestions')?.classList.remove('hidden');
    }

  });

  const searchEl = document.getElementById('search');
  if (searchEl) {
    observer.observe(searchEl, { childList: true, subtree: true });
  }
</script>
