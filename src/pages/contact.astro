---
import BaseLayout from '../layouts/BaseLayout.astro';
import ObfuscatedEmail from '../components/ObfuscatedEmail.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Contact" description="Contact the Beaumont-Wilshire Neighborhood Association.">
  <section class="hero">
    <div class="container">
      <h1>Contact Us</h1>
      <p>Get in touch with BWNA</p>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-width">
      <h2>Email Contacts</h2>
      <p>We aim to respond within a week.</p>
      <ul class="resource-list">
        <li>
          <strong>President (Al Ellis):</strong>
          <ObfuscatedEmail email="president@bwnapdx.org" />
        </li>
        <li>
          <strong>Treasurer (Karla Lenox):</strong>
          <ObfuscatedEmail email="treasurer@bwnapdx.org" />
        </li>
        <li>
          <strong>General Information:</strong>
          <ObfuscatedEmail email="info@bwnapdx.org" />
        </li>
        <li>
          <strong>Events Committee (John Sandie):</strong>
          <ObfuscatedEmail email="events@bwnapdx.org" />
        </li>
        <li>
          <strong>Land Use Committee (Tim Root):</strong>
          <ObfuscatedEmail email="root.timothy@gmail.com" />
        </li>
        <li>
          <strong>Newsletter Editor (Susan Trabucco):</strong>
          <ObfuscatedEmail email="editor@bwnapdx.org" /> or
          <a href="tel:503-440-7732">503-440-7732</a>
        </li>
        <li>
          <strong>Newsletter Graphic Design (Jane Feinberg):</strong>
          <ObfuscatedEmail email="design@bwnapdx.org" />
        </li>
        <li>
          <strong>Newsletter Distribution:</strong>
          Georgina Head (<a href="tel:360-739-7896">360-739-7896</a>) and
          John Sandie (<a href="tel:219-508-4162">219-508-4162</a>)
        </li>
        <li>
          <strong>Plaza Committee (Aaron Breakstone):</strong>
          <ObfuscatedEmail email="plaza@bwnapdx.org" />
        </li>
        <li>
          <strong>Transportation Committee (Graeme Rudd):</strong>
          <ObfuscatedEmail email="pdx.stmptwn@gmail.com" />
        </li>
      </ul>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-width">
      <div class="card card--highlight">
        <h3>Stay in the Loop</h3>
        <p>
          Subscribe to our monthly (or occasionally more often) Community Updates for
          information about meetings, events, neighborhood news, and volunteer opportunities.
        </p>
        <a href={`${base}subscribe`} class="btn btn-secondary">Subscribe</a>
      </div>
    </div>
  </section>
</BaseLayout>
