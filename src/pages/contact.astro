---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Contact" description="Contact the Beaumont-Wilshire Neighborhood Association.">
  <section class="hero">
    <div class="container">
      <h1>Contact Us</h1>
      <p>Get in touch with BWNA</p>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-width">
      <h2>Send Us a Message</h2>
      <form action="https://formspree.io/p/3003290244603706655/f/contact" method="POST" class="contact-form" data-formspree="contact">
        <div class="form-row">
          <div class="form-group">
            <label for="name">Name <span class="required">*</span></label>
            <input type="text" id="name" name="name" required>
          </div>
          <div class="form-group">
            <label for="email">Email <span class="required">*</span></label>
            <input type="email" id="email" name="email" required>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="phone">Phone</label>
            <input type="tel" id="phone" name="phone">
          </div>
          <div class="form-group">
            <label for="subject">Subject</label>
            <input type="text" id="subject" name="subject">
          </div>
        </div>
        <div class="form-group">
          <label for="address">Address</label>
          <input type="text" id="address" name="address" placeholder="Your street address (optional)">
        </div>
        <div class="form-group">
          <label for="message">Message <span class="required">*</span></label>
          <textarea id="message" name="message" rows="6" required></textarea>
        </div>
        <button type="submit" class="btn btn-secondary">Send Message</button>
        <p class="form-status" data-form-status hidden role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-width">
      <h2>Email Contacts</h2>
      <ul class="resource-list">
        <li>
          <strong>President (Al Ellis):</strong>
          <a href="mailto:president@bwnapdx.org">president@bwnapdx.org</a>
        </li>
        <li>
          <strong>Treasurer (Karla Lenox):</strong>
          <a href="mailto:treasurer@bwnapdx.org">treasurer@bwnapdx.org</a>
        </li>
        <li>
          <strong>Newsletter Editor (Susan Trabucco):</strong>
          <a href="mailto:editor@bwnapdx.org">editor@bwnapdx.org</a>
        </li>
        <li>
          <strong>Newsletter Graphic Design (Jane Feinberg):</strong>
          <a href="mailto:design@bwnapdx.org">design@bwnapdx.org</a>
        </li>
        <li>
          <strong>Events:</strong>
          <a href="mailto:events@bwnapdx.org">events@bwnapdx.org</a>
        </li>
        <li>
          <strong>General Information:</strong>
          <a href="mailto:info@bwnapdx.org">info@bwnapdx.org</a>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-form {
    max-width: 600px;
    margin-bottom: var(--spacing-xl);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-md);
  }

  .form-group {
    margin-bottom: var(--spacing-md);
  }

  .form-group label {
    display: block;
    font-weight: 500;
    margin-bottom: var(--spacing-xs);
  }

  .required {
    color: #dc2626;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: var(--spacing-sm) 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-family: var(--font-family);
    font-size: 1rem;
    transition: border-color 0.2s;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(30, 92, 58, 0.1);
  }

  .form-group textarea {
    resize: vertical;
  }

  .form-status {
    margin-top: var(--spacing-md);
    padding: 0.75rem 1rem;
    border-radius: 6px;
    font-size: 0.95rem;
  }

  .form-status--sending {
    background: #f3f4f6;
    color: #374151;
  }

  .form-status--success {
    background: #ecfdf5;
    color: #065f46;
    border: 1px solid #a7f3d0;
  }

  .form-status--error {
    background: #fef2f2;
    color: #991b1b;
    border: 1px solid #fecaca;
  }

  @media (max-width: 500px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import "../scripts/form-submit";
</script>
