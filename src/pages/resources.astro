---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Community Resources" description="Emergency contacts, city services, and helpful resources for Beaumont-Wilshire residents.">

  <!-- Page Header -->
  <section class="hero">
    <div class="container">
      <h1>Community Resources</h1>
      <p>Helpful contacts and links</p>
    </div>
  </section>

  <!-- Emergency Numbers -->
  <section class="page-section">
    <div class="container content-width">
      <h2>🚨 Emergency Phone Numbers</h2>
      <div class="card card--emergency">
        <ul class="resource-list resource-list--emergency">
          <li>
            <strong>Police, Fire, Medical:</strong> <a href="tel:911">911</a>
          </li>
          <li>
            <strong>Suicide Crisis Line:</strong> <a href="tel:988">988</a>
          </li>
          <li>
            <strong>Mental Health Crisis Line:</strong> <a href="tel:503-988-4888">503-988-4888</a>
          </li>
          <li>
            <strong>Women's Crisis Line:</strong> <a href="tel:503-235-5333">503-235-5333</a>
          </li>
          <li>
            <strong>Youthline (teen crisis support):</strong> <a href="tel:877-968-8491">877-968-8491</a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- City Services - Immediate -->
  <section class="page-section">
    <div class="container content-width">
      <h2>🏙️ City of Portland - Immediate Issues</h2>
      <ul class="resource-list">
        <li>
          <strong>Downed Trees:</strong> <a href="tel:503-823-8733">503-823-8733</a>
        </li>
        <li>
          <strong>Sewer Repair Emergencies:</strong> <a href="tel:503-823-1700">503-823-1700</a>
        </li>
        <li>
          <strong>Water Main & Pipe Breaks:</strong> <a href="tel:503-823-4874">503-823-4874</a>
        </li>
        <li>
          <strong>Environmental Spills/Pollution:</strong> <a href="tel:503-823-7180">503-823-7180</a>
        </li>
        <li>
          <strong>Traffic Signals Not Working:</strong> <a href="tel:503-823-1700">503-823-1700</a>
        </li>
        <li>
          <strong>Pothole & Road Hazards:</strong> <a href="tel:503-823-1700">503-823-1700</a>
        </li>
        <li>
          <strong>Abandoned Vehicle:</strong> <a href="tel:503-823-7309">503-823-7309</a>
        </li>
      </ul>
    </div>
  </section>

  <!-- City Services - Non-Immediate -->
  <section class="page-section">
    <div class="container content-width">
      <h2>📞 Non-Emergency Contacts</h2>
      <ul class="resource-list">
        <li>
          <strong>City of Portland General Info:</strong> <a href="tel:311">311</a>
          <span class="detail"> — for all non-emergency questions, reports, and concerns</span>
        </li>
        <li>
          <strong>Police Non-Emergency:</strong> <a href="tel:503-823-3333">503-823-3333</a>
          <span class="detail"> — vandalism, theft, property damage, etc.</span>
        </li>
        <li>
          <strong>Health, Utilities, Housing, Food Assistance:</strong> <a href="tel:211">211</a>
        </li>
        <li>
          <strong>Aging & Disability Hotline:</strong> <a href="tel:503-988-3646">503-988-3646</a>
        </li>
        <li>
          <strong>Alcohol & Drug Resources:</strong> <a href="tel:800-923-4357">800-923-4357</a>
        </li>
        <li>
          <strong>Bias Crime Hotline:</strong> <a href="tel:844-924-2427">844-924-2427</a>
        </li>
      </ul>
    </div>
  </section>

  <!-- Online Resources -->
  <section class="page-section">
    <div class="container content-width">
      <h2>🔗 Helpful Websites</h2>

      <h3 class="link-list-heading">City of Portland</h3>
      <ul class="link-list">
        <li><a href="https://www.portland.gov/help/contact-elected-official" target="_blank" rel="noopener">Contact Mayor or City Council</a></li>
        <li><a href="https://www.portland.gov/auditor" target="_blank" rel="noopener">Portland City Auditor (whistleblower line)</a></li>
        <li><a href="https://www.portland.gov/transportation" target="_blank" rel="noopener">Bureau of Transportation (PBOT)</a></li>
        <li><a href="https://www.portlandparks.gov" target="_blank" rel="noopener">Portland Parks & Recreation</a></li>
        <li><a href="https://www.portland.gov/civic" target="_blank" rel="noopener">Office of Community & Civic Life</a></li>
        <li><a href="https://www.portlandmaps.com" target="_blank" rel="noopener">Portland Maps</a></li>
        <li><a href="https://www.portland.gov/pbem/neighborhood-emergency-teams" target="_blank" rel="noopener">Neighborhood Emergency Team (NET) Program</a></li>
        <li><a href="https://www.portlandoregon.gov/article/15472" target="_blank" rel="noopener">Permitting & Development</a></li>
        <li><a href="/documents/portland-trash-cleanup-resources.pdf" target="_blank" rel="noopener">Portland Trash Cleanup Resources <svg class="pdf-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg><span class="pdf-badge">PDF</span></a></li>
      </ul>

      <h3 class="link-list-heading">Other Government</h3>
      <ul class="link-list">
        <li><a href="https://trimet.org" target="_blank" rel="noopener">TriMet</a></li>
        <li><a href="https://www.oregonmetro.gov" target="_blank" rel="noopener">Metro</a></li>
        <li><a href="https://multco.us" target="_blank" rel="noopener">Multnomah County</a></li>
        <li><a href="https://www.oregon.gov" target="_blank" rel="noopener">Oregon.gov</a></li>
        <li><a href="https://www.oregon.gov/ODOT" target="_blank" rel="noopener">Oregon Department of Transportation</a></li>
        <li><a href="https://justice.oregon.gov/CrimeReporting/BiasCrime" target="_blank" rel="noopener">Oregon Department of Justice</a></li>
        <li><a href="https://www.oregonlegislature.gov/FindYourLegislator" target="_blank" rel="noopener">Find Your State Legislator</a></li>
        <li><a href="https://www.house.gov/representatives/find-your-representative" target="_blank" rel="noopener">Find Your U.S. Representative</a></li>
        <li><a href="https://www.senate.gov/senators/senators-contact.htm" target="_blank" rel="noopener">Contact Your U.S. Senator</a></li>
      </ul>

      <h3 class="link-list-heading">Local Organizations</h3>
      <ul class="link-list">
        <li><a href="https://www.beaumontvillagepdx.com" target="_blank" rel="noopener">Beaumont Business Association</a></li>
        <li><a href="https://www.friendsofwilshirepark.org" target="_blank" rel="noopener">Friends of Wilshire Park</a></li>
        <li><a href="https://www.storetodooroforegon.org" target="_blank" rel="noopener">Store to Door</a></li>
        <li><a href="https://www.communityfpa.org" target="_blank" rel="noopener">Community for Positive Aging</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .pdf-icon {
    vertical-align: -2px;
    margin-left: 0.25rem;
    opacity: 0.7;
  }

  .pdf-badge {
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    background: #dc2626;
    color: white;
    padding: 0.1rem 0.3rem;
    border-radius: 3px;
    margin-left: 0.15rem;
    vertical-align: 1px;
    letter-spacing: 0.03em;
  }
</style>
