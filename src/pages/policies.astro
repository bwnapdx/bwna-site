---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Policies" description="BWNA Policies - operational policies of the Beaumont-Wilshire Neighborhood Association.">
  <section class="hero">
    <div class="container">
      <h1>BWNA Policies</h1>
      <p>Operational policies of the association</p>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-width">
      <p>
        BWNA policies guide the day-to-day operations of the association, covering
        meeting agenda content and the conduct of meetings. These policies are
        subject to change at any time by majority vote of the Board.
      </p>
      <div class="pdf-viewer">
        <object data={`${base}documents/bwna-policies.pdf`} type="application/pdf" width="100%" height="800px">
          <p>Your browser does not support embedded PDFs. <a href={`${base}documents/bwna-policies.pdf`}>Download the BWNA Policies (PDF)</a>.</p>
        </object>
      </div>
      <p class="pdf-download">
        <a href={`${base}documents/bwna-policies.pdf`} class="btn btn-primary" download>Download Policies (PDF)</a>
      </p>
      <p>
        <a href={`${base}about`}>&larr; Back to About Us</a>
      </p>
    </div>
  </section>
</BaseLayout>
