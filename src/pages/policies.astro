---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Policies" description="BWNA Policies - operational policies of the Beaumont-Wilshire Neighborhood Association.">
  <section class="hero" style="padding: 2rem 0;">
    <div class="container">
      <h1>BWNA Policies</h1>
      <p>Operational policies of the association</p>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-width">
      <p>
        BWNA policies guide the day-to-day operations of the association, including
        newsletter advertising, event management, and communication standards.
      </p>
      <div class="card" style="background: var(--color-primary-light); margin: 1.5rem 0;">
        <h3>Policy Areas</h3>
        <ul style="margin-left: 1.5rem;">
          <li><strong>Newsletter advertising</strong> &mdash; rates, content guidelines, and deadlines for ad placement</li>
          <li><strong>Events</strong> &mdash; guidelines for BWNA-sponsored and community events</li>
          <li><strong>Communications</strong> &mdash; standards for official BWNA communications and social media</li>
          <li><strong>Financial</strong> &mdash; budget approval, expenditure authorization, and reporting</li>
        </ul>
      </div>
      <p>
        For the full text of any policy or for questions, please contact
        <a href="mailto:president@bwnapdx.org">president@bwnapdx.org</a>.
      </p>
      <p style="margin-top: 2rem;">
        <a href={`${base}about`}>&larr; Back to About Us</a>
      </p>
    </div>
  </section>
</BaseLayout>
