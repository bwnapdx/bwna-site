---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ObfuscatedEmail from '../components/ObfuscatedEmail.astro';
import { categoryLabels } from '../data/categoryLabels';

const base = import.meta.env.BASE_URL;

// Get articles from content collection, grouped by issue
const allArticles = await getCollection('newsletters');
const issueMap = new Map<string, { slug: string; label: string; articles: typeof allArticles }>();
for (const a of allArticles) {
  const slug = a.data.issueSlug;
  if (!issueMap.has(slug)) {
    issueMap.set(slug, { slug, label: a.data.issue, articles: [] });
  }
  issueMap.get(slug)!.articles.push(a);
}
const issues = Array.from(issueMap.values())
  .sort((a, b) => b.slug.localeCompare(a.slug));
for (const issue of issues) {
  issue.articles.sort((a, b) => (a.data.page ?? 99) - (b.data.page ?? 99));
}

// Web-native 2026 issues (full verbatim transcriptions) whose original print
// PDF is available for download. Kept out of article frontmatter so these
// issues don't inherit the "text-extracted" archive disclaimer. Add more here
// (e.g. '2026-05') as their PDFs come in.
const webIssuePdfs: Record<string, string> = {
  '2026-09': 'bwna-2026-09.pdf',
  '2026-07': 'bwna-2026-07.pdf',
  '2026-05': 'bwna-2026-05.pdf',
  '2026-03': 'bwna-2026-03.pdf',
  '2026-01': 'bwna-2026-01.pdf',
};

// Generate bimonthly newsletter PDF archive (2012-2025)
const bimonthlyPairs = [
  ['Nov', 'Dec', '11'], ['Sep', 'Oct', '09'], ['Jul', 'Aug', '07'],
  ['May', 'Jun', '05'], ['Mar', 'Apr', '03'], ['Jan', 'Feb', '01'],
];

const olderPdfs: { date: string; file: string }[] = [];
for (let year = 2025; year >= 2012; year--) {
  for (const [start, end, month] of bimonthlyPairs) {
    olderPdfs.push({ date: `${start} - ${end} ${year}`, file: `bwna-${year}-${month}.pdf` });
  }
}

// Group by year (already ordered newest-first)
const pdfsByYear: Record<string, typeof olderPdfs> = {};
for (const nl of olderPdfs) {
  const year = nl.date.split(' ').pop()!;
  (pdfsByYear[year] ??= []).push(nl);
}
---

<BaseLayout searchable={false} title="Newsletters" description="Read the BWNA newsletter for neighborhood news, events, and community updates. Browse individual articles or download the full PDF.">

  <section class="hero">
    <div class="container">
      <h1>Newsletter</h1>
      <p>Your source for Beaumont-Wilshire news and updates</p>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-width">
      <p>
        Volunteers produce the Beaumont-Wilshire newsletter, which is published every other
        month starting with the January-February issue. The newsletter is hand-delivered to
        approximately 2,700 B-W homes and many Beaumont Village businesses by a legion of
        sixty-plus volunteers. An online version of each issue is posted on the Newsletters
        page of this website.
      </p>
    </div>
  </section>

  <!-- Issue Articles -->
  {issues.map((issue, i) => {
    const issuePdf = issue.articles[0]?.data.pdfFile ?? webIssuePdfs[issue.slug];
    return (
    <section class={`page-section ${i > 0 ? 'older-issue' : ''}`}>
      <div class="container content-width">
        <div class="issue-header">
          <h2>{issue.label}</h2>
          {issuePdf && (
            <a href={`${base}newsletters/${issuePdf}`} target="_blank" rel="noopener" class="pdf-link">
              Download full issue (PDF)
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
            </a>
          )}
        </div>

        <div class="article-grid">
          {issue.articles.map(article => (
            <a href={`${base}newsletters/${article.id.replace(/\.md$/, '')}`} class="article-link">
              <span>
                <strong>{article.data.title}</strong>
                {article.data.author && <span class="text-muted text-sm"> — {article.data.author}</span>}
              </span>
              <span class="category-badge category-badge--sm">{categoryLabels[article.data.category] || article.data.category}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
    );
  })}

  <section class="page-section">
    <div class="container content-width">
      <div class="section-footer">
        <a href={`${base}articles`} class="btn btn-secondary">Browse All Articles &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Older PDFs -->
  <section class="page-section archive-section">
    <div class="container content-width">
      <h2>Past Issues (PDF)</h2>

      {Object.entries(pdfsByYear).sort(([a], [b]) => Number(b) - Number(a)).map(([year, items], index) => (
        <details class="year-group" open={index === 0}>
          <summary class="year-heading">{year} <span class="year-count">({items.length} {items.length === 1 ? 'issue' : 'issues'})</span></summary>
          <ul class="newsletter-list">
            {items.map((nl) => (
              <li>
                <span>{nl.date}</span>
                <a href={`${base}newsletters/${nl.file}`} target="_blank" rel="noopener" class="download-link">
                  <span>Download PDF</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                    <polyline points="7 10 12 15 17 10"/>
                    <line x1="12" y1="15" x2="12" y2="3"/>
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </details>
      ))}

    </div>
  </section>

  <!-- Contribute -->
  <section class="page-section">
    <div class="container content-width">
      <div class="grid grid-2 contribute-grid">
        <div class="card">
          <h3>Contribute Content</h3>
          <p>
            Have a story, event, or announcement for the newsletter? We welcome
            contributions from neighbors!
          </p>
          <ObfuscatedEmail email="editor@bwnapdx.org" label="Contact the Editor" />
        </div>

        <div class="card">
          <h3>Advertise</h3>
          <p>
            Support the newsletter and reach 2,700+ local households with your
            business or organization.
          </p>
          <a href={`${base}ad-rates`}>View Ad Rates</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Email Subscribe -->
  <section class="page-section cta-section">
    <div class="container">
      <h2>Get Timely Updates between Newsletters</h2>
      <p>
        Receive our monthly Community Updates by email to stay informed about meetings, events,
        neighborhood news, and volunteer opportunities.
      </p>
      <div class="cta-buttons">
        <a href={`${base}community-updates`} class="btn btn-primary">Read Community Updates</a>
        <a href={`${base}subscribe`} class="btn btn-secondary">Subscribe to Community Updates</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .issue-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--spacing-md);
  }

  .article-grid {
    display: grid;
    gap: 0.5rem;
  }

  .article-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.875rem 1rem;
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s;
  }

  .article-link:hover {
    border-color: var(--color-primary);
    text-decoration: none;
  }

  .article-link strong {
    color: var(--color-primary);
  }

  .archive-section {
    background: var(--color-background-alt);
  }

  .contribute-grid {
    gap: var(--spacing-xl);
  }

  .cta-buttons {
    display: flex;
    gap: var(--spacing-sm);
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
