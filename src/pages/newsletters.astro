---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { categoryLabels } from '../data/categoryLabels';

const base = import.meta.env.BASE_URL;

// Get articles from content collection
const allArticles = await getCollection('newsletters');
const latestIssueSlug = '2026-01';
const latestArticles = allArticles
  .filter(a => a.data.issueSlug === latestIssueSlug)
  .sort((a, b) => (a.data.page ?? 99) - (b.data.page ?? 99));

// Generate bimonthly newsletter PDF archive (2012-2025)
const bimonthlyPairs = [
  ['Nov', 'Dec', '11'], ['Sep', 'Oct', '09'], ['Jul', 'Aug', '07'],
  ['May', 'Jun', '05'], ['Mar', 'Apr', '03'], ['Jan', 'Feb', '01'],
];

const olderPdfs: { date: string; file: string }[] = [];
for (let year = 2025; year >= 2012; year--) {
  for (const [start, end, month] of bimonthlyPairs) {
    olderPdfs.push({ date: `${start} - ${end} ${year}`, file: `bwna-${year}-${month}.pdf` });
  }
}

// Group by year (already ordered newest-first)
const pdfsByYear: Record<string, typeof olderPdfs> = {};
for (const nl of olderPdfs) {
  const year = nl.date.split(' ').pop()!;
  (pdfsByYear[year] ??= []).push(nl);
}
---

<BaseLayout title="Newsletters" description="Read the BWNA newsletter for neighborhood news, events, and community updates. Browse individual articles or download the full PDF.">

  <section class="hero">
    <div class="container">
      <h1>Newsletter</h1>
      <p>Your source for Beaumont-Wilshire news and updates</p>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-width">
      <p>
        BWNA produces a free bimonthly newsletter that is distributed to the doorsteps of
        over 2,600 neighborhood residences and businesses by volunteers. Advertisements by
        local merchants and organizations support the newsletter, which invites letters,
        editorials, articles, and announcements from neighbors.
      </p>
    </div>
  </section>

  <!-- Latest Issue Articles -->
  <section class="page-section">
    <div class="container content-width">
      <div class="issue-header">
        <h2>Jan-Feb 2026</h2>
        <a href={`${base}newsletters/bwna-2026-01.pdf`} target="_blank" rel="noopener" class="pdf-link">
          Download full issue (PDF)
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
        </a>
      </div>

      <div class="article-grid">
        {latestArticles.map(article => (
          <a href={`${base}newsletters/${article.id.replace(/\.md$/, '')}`} class="article-link">
            <span>
              <strong>{article.data.title}</strong>
              {article.data.author && <span class="text-muted text-sm"> — {article.data.author}</span>}
            </span>
            <span class="category-badge category-badge--sm">{categoryLabels[article.data.category] || article.data.category}</span>
          </a>
        ))}
      </div>

      <div class="section-footer">
        <a href={`${base}articles`} class="btn btn-secondary">Browse All Articles &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Older PDFs -->
  <section class="page-section archive-section">
    <div class="container content-width">
      <h2>Past Issues (PDF)</h2>

      {Object.entries(pdfsByYear).sort(([a], [b]) => Number(b) - Number(a)).map(([year, items], index) => (
        <details class="year-group" open={index === 0}>
          <summary class="year-heading">{year} <span class="year-count">({items.length} issues)</span></summary>
          <ul class="newsletter-list">
            {items.map((nl) => (
              <li>
                <span>{nl.date}</span>
                <a href={`${base}newsletters/${nl.file}`} target="_blank" rel="noopener" class="download-link">
                  <span>Download PDF</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                    <polyline points="7 10 12 15 17 10"/>
                    <line x1="12" y1="15" x2="12" y2="3"/>
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </details>
      ))}

    </div>
  </section>

  <!-- Contribute -->
  <section class="page-section">
    <div class="container content-width">
      <div class="grid grid-2 contribute-grid">
        <div class="card">
          <h3>Contribute Content</h3>
          <p>
            Have a story, event, or announcement for the newsletter? We welcome
            contributions from neighbors!
          </p>
          <a href="mailto:editor@bwnapdx.org">Contact the Editor</a>
        </div>

        <div class="card">
          <h3>Advertise</h3>
          <p>
            Support the newsletter and reach 2,600+ local households with your
            business or organization.
          </p>
          <a href={`${base}ad-rates`}>View Ad Rates</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Email Subscribe -->
  <section class="page-section cta-section">
    <div class="container">
      <h2>Get Updates by Email</h2>
      <p>
        Can't wait for the printed newsletter? BWNA also sends a monthly
        <strong>Community Update</strong> by email — meetings, events, and neighborhood news.
      </p>
      <div class="cta-buttons">
        <a href={`${base}community-updates`} class="btn btn-primary">Read Community Updates</a>
        <a href={`${base}subscribe`} class="btn btn-secondary">Subscribe by Email</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .issue-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--spacing-md);
  }

  .article-grid {
    display: grid;
    gap: 0.5rem;
  }

  .article-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.875rem 1rem;
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s;
  }

  .article-link:hover {
    border-color: var(--color-primary);
    text-decoration: none;
  }

  .article-link strong {
    color: var(--color-primary);
  }

  .archive-section {
    background: var(--color-background-alt);
  }

  .contribute-grid {
    gap: var(--spacing-xl);
  }

  .cta-buttons {
    display: flex;
    gap: var(--spacing-sm);
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
