---
import BaseLayout from '../layouts/BaseLayout.astro';
import ObfuscatedEmail from '../components/ObfuscatedEmail.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout searchable={false} title="Newsletter Archive" description="Complete archive of BWNA newsletters from 2012 to present.">
  <section class="hero">
    <div class="container">
      <h1>Newsletter Archive</h1>
      <p>Complete collection from 2012 to present</p>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-width">
      <p>
        Recent issues (2023&ndash;present) are available as downloadable PDFs on our
        <a href={`${base}newsletters`}>newsletters page</a>.
      </p>
      <p>
        We are working on making individual articles from each issue available as searchable
        web content. For older issues (2012&ndash;2022), please contact
        <ObfuscatedEmail email="editor@bwnapdx.org" />.
      </p>
      <p class="back-link">
        <a href={`${base}newsletters`}>&larr; Back to Newsletters</a>
      </p>
    </div>
  </section>
</BaseLayout>
