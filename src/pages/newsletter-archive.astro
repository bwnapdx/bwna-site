---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout searchable={false} title="Newsletter Archive" description="Complete archive of BWNA newsletters from 2002 to present.">
  <section class="hero">
    <div class="container">
      <h1>Newsletter Archive</h1>
      <p>Complete collection from 2002 to present</p>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-width">
      <p>
        Every issue from December 2001 to the present is available as a downloadable PDF on our
        <a href={`${base}newsletters`}>newsletters page</a>. You can also browse and search
        individual <a href={`${base}articles`}>articles</a>.
      </p>
      <p class="back-link">
        <a href={`${base}newsletters`}>&larr; Back to Newsletters</a>
      </p>
    </div>
  </section>
</BaseLayout>
