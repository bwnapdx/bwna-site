---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ObfuscatedEmail from '../components/ObfuscatedEmail.astro';
import PageHero from '../components/PageHero.astro';
import SignupBand from '../components/SignupBand.astro';
import { expandEvents, toLocalDate } from '../data/expandEvents';
import StaleEventFilter from '../components/StaleEventFilter.astro';

const base = import.meta.env.BASE_URL;

// Upcoming events at the plaza, pulled from our own calendar. Empty for most of
// the year — the section only renders when something is actually scheduled.
// We render spares past the four on show so StaleEventFilter can retire the
// ones that pass between deploys and promote the next in line.
const VISIBLE_EVENTS = 4;
const plazaEvents = expandEvents(await getCollection('events'))
  .filter(e => /beaumont crossing/i.test(e.entry.data.location))
  .slice(0, 10);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });
}

/** Local calendar day as YYYY-MM-DD — toISOString() would shift it west of Greenwich. */
const ymd = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
---

<BaseLayout
  title="Public Plaza"
  description="Beaumont Crossing, the public plaza at NE 44th Avenue and Fremont Street — upcoming events, how to schedule your own, and what happens after the trial period."
>

  <PageHero
    title="Public Plaza"
    subtitle="Beaumont Crossing &mdash; NE 44th Avenue at Fremont"
    image={`${base}images/hero/hero-plaza`}
    imageAlt="Neighbors at tables and umbrellas on the painted street surface at Beaumont Crossing"
    maxWidth={1200}
  />

  <section class="page-section">
    <div class="container content-width">
      <h2>About the Plaza</h2>
      <p>Take the time to get out and enjoy this neighborhood gathering space!</p>
      <p>
        This public plaza on NE 44th Avenue at Fremont will hold events through September 2026,
        then close for an assessment by the Portland Bureau of Transportation (PBOT). Positive
        results mean it may reopen permanently next spring or summer. So be sure to experience
        Beaumont Crossing &mdash; our neighborhood gathering place.
      </p>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-width" data-events-list>
      <h2>Find Scheduled Events</h2>
      <p>
        Check our <a href={`${base}events`}>Upcoming Events</a> page or the
        Beaumont Business Association (BBA)
        <a href="https://bbapdx.org/calendar" target="_blank" rel="noopener">calendar page</a>
        for Beaumont Crossing events. You can also follow the
        <a href="https://www.instagram.com/bbapdx" target="_blank" rel="noopener">BBA on Instagram</a>
        for timely announcements.
      </p>

      {plazaEvents.length > 0 && (
        <ul class="plaza-events" data-event-group>
          {plazaEvents.map((ev, i) => (
            <li
              data-event
              hidden={i >= VISIBLE_EVENTS}
              data-start={ymd(ev.date)}
              data-end={!ev.entry.data.recurring && ev.entry.data.endDate
                ? ymd(toLocalDate(ev.entry.data.endDate))
                : undefined}
            >
              {(ev.entry.body || '').trim().length > 10 ? (
                <a href={`${base}events/${ev.entry.id.replace(/\.md$/, '')}`}>{ev.entry.data.title}</a>
              ) : (
                <span>{ev.entry.data.title}</span>
              )}
              <span class="detail">{formatDate(ev.date)} &middot; {ev.entry.data.time}</span>
            </li>
          ))}
        </ul>
      )}
      <StaleEventFilter limit={VISIBLE_EVENTS} />
    </div>
  </section>

  <section class="page-section">
    <div class="container content-width">
      <h2>Schedule an Event</h2>
      <p>
        Have an event idea? Individuals and community organizations are encouraged to schedule
        community events at Beaumont Crossing through September 2026. Possibilities include
        music, family-friendly activities, dancing, and pet contests &mdash; if you can dream
        it up, you can schedule it!
      </p>
      <p>
        For more event ideas, visit
        <a href="https://www.portland.gov/transportation/planning/plazas/events" target="_blank" rel="noopener">PBOT's event scheduling site</a>.
      </p>
      <p>
        The plaza is open to all, there is no fee for most community events, and the application
        process is simple! So, what are you waiting for?
      </p>
      <p>
        <a
          href="https://www.portland.gov/transportation/planning/plazas/community-events-plaza"
          class="btn btn-secondary"
          target="_blank"
          rel="noopener"
        >Schedule an Event</a>
      </p>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-width">
      <h2>What Comes Next?</h2>
      <p>
        Beaumont Crossing is a pilot street plaza through PBOT&rsquo;s first-ever Open Call for
        Plaza Partners. Barriers and furniture will be removed on September 30 at the end of
        the three-month trial period.
      </p>
      <p>
        The purpose of the pilot is to allow for direct observation through tangible,
        on-the-ground experience with the plaza in place. This information is part of an
        evaluation process conducted by PBOT to inform consideration of next steps. A key
        component of the evaluation is a survey conducted by PBOT to hear from the neighborhood
        about your experiences with Beaumont Crossing &mdash; please follow the link below to
        offer your thoughts. Results of the evaluation will be shared publicly on the PBOT
        webpage. If it reveals that the plaza site functioned well and there is widespread
        neighborhood support, the Beaumont Business Association, Beaumont-Wilshire Neighborhood
        Association, and PBOT will consider bringing Beaumont Crossing back as a permanent
        member of PBOT&rsquo;s Public Street Plaza Program.
      </p>
      <p>
        <a
          href="https://www.surveymonkey.com/r/beaumontcrossing"
          class="btn btn-secondary"
          target="_blank"
          rel="noopener"
        >Take the Survey</a>
      </p>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-width">
      <div class="card card--highlight plaza-contact">
        <h3>Your feedback and questions are appreciated!</h3>
        <p>
          Email the BWNA Plaza Committee to provide feedback on the plaza or ask a question.
        </p>
        <ObfuscatedEmail email="plaza@bwnapdx.org" label="Email the Plaza Committee" class="btn btn-secondary" />
      </div>

      <p class="partners-note">
        Beaumont Crossing is a joint project of the Beaumont-Wilshire Neighborhood Association,
        the Beaumont Business Association (BBA), and the Portland Bureau of Transportation
        (PBOT). For more about the city's street plaza program, visit
        <a href="https://www.portland.gov/transportation/planning/plazas" target="_blank" rel="noopener">PBOT's associated webpage</a>.
      </p>
    </div>
  </section>

  <SignupBand />

</BaseLayout>

<style>
  .plaza-events {
    list-style: none;
    padding: 0;
    margin: var(--spacing-lg) 0;
    border-top: 1px solid var(--color-border);
  }

  .plaza-events li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    padding: var(--spacing-sm) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .plaza-events li[hidden] {
    display: none;
  }

  .plaza-events .detail {
    font-size: 0.9rem;
    color: var(--color-text-light);
  }

  .plaza-contact {
    text-align: center;
  }

  .partners-note {
    margin-top: var(--spacing-xl);
    font-size: 0.95rem;
    color: var(--color-text-light);
  }
</style>
