---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Ad Rates" description="Advertising rates for the BWNA newsletter.">
  <section class="hero">
    <div class="container">
      <h1>Newsletter Advertising</h1>
      <p>Reach 2,600+ local households</p>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-width">
      <p>
        The BWNA newsletter is distributed to over 2,600 residences and businesses in the
        Beaumont-Wilshire neighborhood. Advertising revenue supports the cost of printing
        and distributing the newsletter.
      </p>
      <p>
        For current ad rates, availability, and specifications, please contact the
        newsletter editor at
        <a href="mailto:editor@bwnapdx.org">editor@bwnapdx.org</a>.
      </p>

      <div class="card card--highlight">
        <h3>Why Advertise with BWNA?</h3>
        <ul class="spaced-list">
          <li>Reach 2,600+ neighborhood households directly</li>
          <li>Support your local neighborhood association</li>
          <li>Bimonthly publication — 6 issues per year</li>
          <li>Delivered to every doorstep by volunteers</li>
        </ul>
      </div>

      <p class="back-link">
        <a href={`${base}newsletters`}>&larr; Back to Newsletters</a>
      </p>
    </div>
  </section>
</BaseLayout>
