---
import BaseLayout from '../layouts/BaseLayout.astro';
import ObfuscatedEmail from '../components/ObfuscatedEmail.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Ad Rates" description="Advertising rates for the BWNA newsletter.">
  <section class="hero">
    <div class="container">
      <h1>Newsletter Advertising</h1>
      <p>Hyper-local &mdash; reach over 5,000 readers</p>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-width">
      <p>
        Advertising in our bimonthly newsletter is a cost-efficient and productive way to reach
        dedicated readers who love their hyper-local news &mdash; your advertising will be seen!
      </p>
      <p>
        We deliver to over 2,700 households in the Beaumont-Wilshire neighborhood, with
        readership estimated to be over 5,000. See
        <a href={`${base}documents/bwna-ad-rates-2026.pdf`} target="_blank" rel="noopener">our current ad rates</a>
        for deadlines, submission information, and payment options.
      </p>
      <div class="pdf-viewer-wrapper">
        <div class="pdf-header">
          <h2>2026 Ad Rate Card</h2>
          <a href={`${base}documents/bwna-ad-rates-2026.pdf`} target="_blank" rel="noopener" class="pdf-link">
            Download PDF
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
          </a>
        </div>
        <iframe src={`${base}documents/bwna-ad-rates-2026.pdf`} class="pdf-embed" title="BWNA 2026 Ad Rate Card"></iframe>
      </div>

      <p>
        After reviewing the rate sheet,
        <ObfuscatedEmail email="editor@bwnapdx.org" label="email the Editor" />
        to confirm space availability.
      </p>

      <p class="back-link">
        <a href={`${base}newsletters`}>&larr; Back to Newsletters</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .pdf-viewer-wrapper {
    margin: var(--spacing-lg) 0;
  }

  .pdf-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--spacing-sm);
  }

  .pdf-embed {
    width: 100%;
    height: 800px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
  }
</style>
